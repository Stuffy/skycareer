@page "/aircraft/edit"
@inherits CareerPageBase
@inject ContentStore Store
@inject FlightMonitorService Monitor
@inject IDialogService Dialogs
@inject NavigationManager Nav
@inject SimBriefCatalogService SimBriefTypes
@using SkyCareer.Integrations.SimBrief

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">@_title</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Text" Href="aircraft">@T("Cancel")</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(Busy || HasErrors)" OnClick="Save">@T("Save")</MudButton>
</MudStack>

@if (_hint is not null)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">@_hint</MudAlert>
}

@if (Id is null)
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-1">@T("SimBrief type")</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            @(HasSimData
                ? T("Takes the weight limits (MZFW, MTOW, MLW), fuel capacity, fuel burn, cruise speed and minimum runway length from SimBrief. Empty weight, load stations and sim detection stay as read from the sim.")
                : T("Creates the profile from the type's SimBrief data, even without a running sim. Empty weight and seats come from SimBrief; add the load stations later with “Take stations from sim”."))
        </MudText>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudAutocomplete T="SimBriefType" @bind-Value="_simBriefType" SearchFunc="SearchSimBrief" ToStringFunc="@(t => t?.Label)"
                             Label="@T("Search type (ICAO or name)")" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:360px"
                             MaxItems="30" ResetValueOnEmptyText="true" />
            <MudButton Variant="Variant.Outlined" Disabled="@(_simBriefType is null || Busy)" OnClick="ApplySimBrief">
                @(HasSimData ? T("Apply SimBrief values") : T("Create profile from SimBrief"))
            </MudButton>
        </MudStack>
        @if (_simBriefError is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@_simBriefError</MudAlert>
        }
    </MudPaper>
}

<MudGrid>
    <MudItem xs="12" lg="8">
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">@T("General")</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6"><MudTextField T="string" Value="_form.Name" ValueChanged="NameChanged" Label="@T("Name")" Variant="Variant.Outlined" Immediate="true" /></MudItem>
                <MudItem xs="12" sm="4"><MudTextField @bind-Value="_form.Id" Label="@T("ID (file name)")" Variant="Variant.Outlined" Immediate="true" @bind-Value:after="() => _idTouched = true" /></MudItem>
                <MudItem xs="12" sm="2"><MudTextField @bind-Value="_form.IcaoType" Label="@T("ICAO type")" Variant="Variant.Outlined" Immediate="true" /></MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_form.SimMatch" Label="@T("Sim detection (parts of the title/ATC model, comma-separated)")" Variant="Variant.Outlined" Immediate="true"
                                  HelperText="@SimMatchHelper" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">@T("Weights & fuel")</MudText>
            <MudGrid>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="_form.OperatingEmptyKg" Label="@T("Empty weight kg")" Variant="Variant.Outlined" Min="0" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="_form.MaxZeroFuelKg" Label="MZFW kg" Variant="Variant.Outlined" Min="0" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="_form.MaxTakeoffKg" Label="MTOW kg" Variant="Variant.Outlined" Min="0" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="_form.MaxLandingKg" Label="MLW kg" Variant="Variant.Outlined" Min="0" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="_form.MaxFuelKg" Label="@T("Fuel capacity kg")" Variant="Variant.Outlined" Min="0" /></MudItem>
                <MudItem xs="6" sm="3">
                    <MudSelect @bind-Value="_form.FuelType" Label="@T("Fuel")" Variant="Variant.Outlined">
                        <MudSelectItem Value="FuelType.JetA">Jet-A</MudSelectItem>
                        <MudSelectItem Value="FuelType.AvGas">AvGas</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="_form.CrewCount" Label="@T("Pilots")" Variant="Variant.Outlined" Min="1" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="_form.CabinCrewCount" Label="@T("Cabin crew")" Variant="Variant.Outlined" Min="0" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="_form.CrewMassKg" Label="@T("Weight per pilot (kg)")" Variant="Variant.Outlined" Min="0" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="_form.CabinCrewMassKg" Label="@T("Weight per flight attendant (kg)")" Variant="Variant.Outlined" Min="0" /></MudItem>
                <MudItem xs="12">
                    <MudCheckBox @bind-Value="_form.CrewIncludedInEmptyWeight" Label="@T("Crew is included in the empty weight (don't load crew stations)")" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">@T("Performance & operations")</MudText>
            <MudGrid>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="_form.CruiseKtas" Label="@T("Cruise TAS kt")" Variant="Variant.Outlined" Min="0" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="_form.FuelBurnKgPerHour" Label="@T("Fuel burn kg/h")" Variant="Variant.Outlined" Min="0" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="_form.TaxiFuelKg" Label="@T("Taxi fuel kg")" Variant="Variant.Outlined" Min="0" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="_form.MinRunwayM" Label="@T("Min. runway m")" Variant="Variant.Outlined" Min="0" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_form.SimBriefAirframe" Label="@T("SimBrief airframe ID (optional)")" Variant="Variant.Outlined"
                                                      HelperText="@T("Your own SimBrief airframe instead of the default type, e.g. 123456_1700000000000")" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="_form.PassengerSeats" Label="@T("Passenger seats")" Variant="Variant.Outlined" Min="0" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="_form.MaxCargoKg" Label="@T("Baggage/cargo kg")" Variant="Variant.Outlined" Min="0" /></MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="RunwaySurface" MultiSelection="true" @bind-SelectedValues="_form.Surfaces" Label="@T("Runway surfaces")" Variant="Variant.Outlined">
                        @foreach (var s in Enum.GetValues<RunwaySurface>())
                        {
                            <MudSelectItem Value="@s">@SurfaceText(s)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" MultiSelection="true" @bind-SelectedValues="_form.Tags" Label="@T("Capabilities (tags)")" Variant="Variant.Outlined">
                        @foreach (var t in KnownTags)
                        {
                            <MudSelectItem Value="@t">@t</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_form.ExtraTags" Label="@T("More tags (comma-separated)")" Variant="Variant.Outlined" Immediate="true" /></MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Spacing="2">
                <MudText Typo="Typo.h6">@T("Loading")</MudText>
                <MudSelect @bind-Value="_form.Loading" Label="@T("Method")" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:320px">
                    <MudSelectItem Value="LoadingMethod.SimConnectStations">@T("SimConnect stations (app loads)")</MudSelectItem>
                    <MudSelectItem Value="LoadingMethod.Manual">@T("Manual in the EFB (app only checks)")</MudSelectItem>
                    <MudSelectItem Value="LoadingMethod.LVar">@T("Aircraft L:Vars")</MudSelectItem>
                </MudSelect>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(Busy || Monitor.Inspector is null)" OnClick="StationsFromSim">@T("Take stations from sim")</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="AddStation">@T("Add station")</MudButton>
            </MudStack>
            @if (_form.Stations.Count > 0)
            {
                <MudSimpleTable Dense="true">
                    <thead><tr><th style="width:70px">#</th><th>@T("Name")</th><th style="width:170px">@T("Kind")</th><th style="width:110px">@T("Seats")</th><th style="width:130px">@T("Max. kg")</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var st in _form.Stations)
                        {
                            <tr>
                                <td><MudNumericField @bind-Value="st.Index" Min="1" Margin="Margin.Dense" /></td>
                                <td><MudTextField @bind-Value="st.Name" Margin="Margin.Dense" /></td>
                                <td>
                                    <MudSelect @bind-Value="st.Kind" Margin="Margin.Dense">
                                        <MudSelectItem Value="StationKind.Crew">@T("Crew")</MudSelectItem>
                                        <MudSelectItem Value="StationKind.Passengers">@T("Passengers")</MudSelectItem>
                                        <MudSelectItem Value="StationKind.Baggage">@T("Baggage")</MudSelectItem>
                                        <MudSelectItem Value="StationKind.Cargo">@T("Cargo")</MudSelectItem>
                                    </MudSelect>
                                </td>
                                <td><MudNumericField @bind-Value="st.Seats" Min="0" Margin="Margin.Dense" Disabled="@(st.Kind is StationKind.Baggage or StationKind.Cargo)" /></td>
                                <td><MudNumericField @bind-Value="st.MaxKg" Min="0" Margin="Margin.Dense" Disabled="@(st.Kind is StationKind.Passengers or StationKind.Crew)" /></td>
                                <td><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="() => _form.Stations.Remove(st)" aria-label="@T("Remove station")" /></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
                <MudStack Row="true" Spacing="2" Class="mt-2">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@(_form.SeatsFromStations == _form.PassengerSeats)"
                               OnClick="() => _form.PassengerSeats = _form.SeatsFromStations">@F("Apply seats ({0})", _form.SeatsFromStations)</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@(_form.CargoFromStations <= 0 || _form.CargoFromStations == _form.MaxCargoKg)"
                               OnClick="() => _form.MaxCargoKg = _form.CargoFromStations">@F("Apply cargo capacity ({0:N0} kg)", _form.CargoFromStations)</MudButton>
                </MudStack>
            }
        </MudPaper>

        <MudPaper Class="pa-4 mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.h6">@T("Economic data")</MudText>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="Estimate" Disabled="@(Reference is null)">
                    @T("Estimate empty values")@(Reference is { } r ? " " + F("(from {0})", r.Name) : "")
                </MudButton>
            </MudStack>
            <MudGrid>
                <MudItem xs="6" sm="4"><MudNumericField @bind-Value="_form.PurchasePriceNew" Label="@T("Purchase price €")" Variant="Variant.Outlined" Min="0" /></MudItem>
                <MudItem xs="6" sm="4"><MudNumericField @bind-Value="_form.LeasePerMonth" Label="@T("Lease €/month")" Variant="Variant.Outlined" Min="0" /></MudItem>
                <MudItem xs="6" sm="4"><MudNumericField @bind-Value="_form.RentPerBlockHour" Label="@T("Rent €/block hour")" Variant="Variant.Outlined" Min="0" /></MudItem>
                <MudItem xs="6" sm="4"><MudNumericField @bind-Value="_form.MaintenancePerFlightHour" Label="@T("Maintenance €/flight hour")" Variant="Variant.Outlined" Min="0" /></MudItem>
                <MudItem xs="6" sm="4"><MudNumericField @bind-Value="_form.InsurancePerMonth" Label="@T("Insurance €/month")" Variant="Variant.Outlined" Min="0" /></MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="4">
        <div style="position:sticky; top:72px">
            <MudPaper Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" Class="mb-2">@T("Validation")</MudText>
                @if (Issues.Count == 0)
                {
                    <MudText Class="ok">@T("No problems found.")</MudText>
                }
                @foreach (var i in Issues)
                {
                    <MudAlert Severity="@(i.Level == IssueLevel.Error ? Severity.Error : Severity.Warning)" Dense="true" Class="mb-1">@i.Message</MudAlert>
                }
            </MudPaper>
            <MudPaper Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" Class="mb-2">@T("Key figures")</MudText>
                <MudSimpleTable Dense="true">
                    <tbody>
                        <tr><td>@T("Max. payload (MZFW − empty − crew)")</td><td>@Math.Max(0, Preview.MaxZeroFuelKg - Preview.OperatingEmptyKg - Preview.CrewMass.Kg).ToString("N0") kg</td></tr>
                        <tr><td>@T("Range (full tanks, 45 min reserve)")</td><td>@RequirementEvaluator.EstimatedRangeNm(Preview).ToString("N0") nm</td></tr>
                        <tr><td>@T("Endurance")</td><td>@(Preview.FuelBurnKgPerHour > 0 ? (Preview.MaxFuelKg / Preview.FuelBurnKgPerHour).ToString("0.0") + " h" : "–")</td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">@T("Available missions")</MudText>
                @foreach (var m in Store.Current.MissionTypes)
                {
                    var r = RequirementEvaluator.Evaluate(m, Preview);
                    <MudText Typo="Typo.body2" Class="@(r.Eligible ? "ok" : "")">
                        @(r.Eligible ? "✔" : "✘") @m.DisplayName
                        @if (!r.Eligible) { <MudText Typo="Typo.caption" Inline="true"> – @string.Join("; ", r.Reasons)</MudText> }
                    </MudText>
                }
            </MudPaper>
        </div>
    </MudItem>
</MudGrid>

@code {
    [SupplyParameterFromQuery] public string? Id { get; set; }
    [SupplyParameterFromQuery] public string? Copy { get; set; }
    [SupplyParameterFromQuery] public bool FromSim { get; set; }
    /// <summary>Start from a SimBrief type (empty: just show the type search).</summary>
    [SupplyParameterFromQuery(Name = "simbrief")] public string? SimBrief { get; set; }

    private SimBriefType? _simBriefType;
    private string? _simBriefError;

    /// <summary>Stations come from the sim; SimBrief then only fills limits and performance.</summary>
    private bool HasSimData => _form.Stations.Count > 0;

    private ProfileForm _form = new();
    private string _title = T("New aircraft profile");
    private string? _hint, _originalId;
    private bool _idTouched, _loaded;

    protected override bool NeedsCareer => false;

    private AircraftProfile Preview => _form.ToProfile();
    private IReadOnlyList<ProfileIssue> Issues => AircraftProfileValidator.Validate(Preview);
    private bool HasErrors => Issues.Any(i => i.Level == IssueLevel.Error);
    private AircraftProfile? Reference => AircraftProfileEstimator.MostSimilar(Preview, Store.Current.Aircraft);

    private IEnumerable<string> KnownTags =>
        new[] { "pax", "cargo", "jet", "turboprop", "piston", "helicopter", "turbine", "single_engine", "multi_engine", "pressurized",
                "airliner", "business", "utility", "medevac", "hoist", "unpaved_ok", "stol", "float", "amphibian", "ski", "trainer", "military", "single_pilot" }
            .Concat(Store.Current.Aircraft.SelectMany(a => a.Tags))
            .Concat(Store.Current.MissionTypes.SelectMany(m => m.Requirements.RequiredTags.Concat(m.Requirements.AnyOfTags)))
            .Distinct(StringComparer.OrdinalIgnoreCase).Order();

    private string SimMatchHelper => Monitor.Latest is { AircraftTitle.Length: > 0 } t && Monitor.Connection == ConnectionState.Connected
        ? F("Currently in the sim: “{0}” – {1}", t.AircraftTitle, Preview.MatchesSimTitle(t.AircraftTitle) ? T("recognised ✔") : T("not recognised"))
        : T("Compared with the title of the loaded aircraft.");

    // Only the first load initialises the form; later career/content changes must not discard edits.
    protected override async Task LoadAsync()
    {
        if (_loaded) return;
        _loaded = true;

        if (Id is not null && Store.Current.Aircraft.FirstOrDefault(a => a.Id == Id) is { } existing)
        {
            _form = ProfileForm.From(existing);
            _originalId = existing.Id;
            _idTouched = true;
            bool own = Store.IsUserProfile(existing.Id);
            _title = own ? F("Edit profile: {0}", existing.Name) : F("Customise shipped profile: {0}", existing.Name);
            if (!own) _hint = T("Saving creates your own profile with the same ID that replaces the shipped one. Deleting it restores the original.");
        }
        else if (Copy is not null && Store.Current.Aircraft.FirstOrDefault(a => a.Id == Copy) is { } source)
        {
            _form = ProfileForm.From(source with { Id = source.Id + "_kopie", Name = source.Name + " " + T("(copy)") });
            _title = F("Copy of {0}", source.Name);
        }
        else if (FromSim)
        {
            await FillFromSim();
            // Offer the matching SimBrief type right away.
            if (await TryCatalogAsync() is { } catalog) _simBriefType = catalog.Find(_form.IcaoType);
        }
        else if (!string.IsNullOrWhiteSpace(SimBrief) && await TryCatalogAsync() is { } catalog && catalog.Find(SimBrief) is { } type)
        {
            _simBriefType = type;
            ApplySimBrief();
        }
    }

    private async Task<SimBriefAircraftCatalog?> TryCatalogAsync()
    {
        try
        {
            _simBriefError = null;
            return await SimBriefTypes.GetAsync();
        }
        catch (InvalidOperationException ex)
        {
            _simBriefError = ex.Message;
            return null;
        }
    }

    private async Task<IEnumerable<SimBriefType>> SearchSimBrief(string? text, CancellationToken ct) =>
        await TryCatalogAsync() is { } catalog ? catalog.Search(text) : [];

    private void ApplySimBrief()
    {
        if (_simBriefType is not { } t) return;
        if (HasSimData)
        {
            var stations = _form.Stations;
            var (merged, warning) = SimBriefProfileDraft.Merge(Preview, t);
            _form = ProfileForm.From(merged);
            _form.Stations = stations;
            _hint = F("Limits and performance data taken from SimBrief ({0}); empty weight, stations and sim detection from the sim.", t.Label) +
                    (warning is null ? "" : " " + warning);
        }
        else
        {
            _form = ProfileForm.From(SimBriefProfileDraft.FromSimBrief(t, Store.Current.Aircraft));
            _idTouched = false;
            _title = F("New profile: {0}", t.Name);
            _hint = T("Taken from SimBrief: weights, fuel capacity, seats, fuel burn, cruise speed and minimum runway length; prices estimated from a similar profile. Empty weight comes from SimBrief and may differ from the sim; take the stations from the sim later. Adjust “Sim detection” to the title of the sim aircraft.");
        }
    }

    private async Task FillFromSim()
    {
        if (Monitor.Inspector is not { } inspector)
        {
            _hint = T("Not connected to MSFS – fill in the profile manually or start the sim and try again.");
            return;
        }
        await Run(async () =>
        {
            var snap = await inspector.ReadAircraftAsync();
            var draft = ProfileDraftBuilder.Build(snap, Store.Current.Aircraft);
            _form = ProfileForm.From(draft);
            _title = F("New profile: {0}", snap.Title);
            var reference = AircraftProfileEstimator.MostSimilar(draft, Store.Current.Aircraft);
            _hint = (snap.Design is not null
                        ? T("Taken from the sim: empty weight, max. takeoff weight, fuel capacity, stations, engine type and cruise speed.")
                        : T("Taken from the sim: empty weight, max. takeoff weight, fuel capacity, stations.")) + " " +
                    (reference is null ? "" : F("Fuel burn, cargo capacity and prices are estimated from “{0}”.", reference.Name) + " ") +
                    T("The sim doesn't report MZFW and MLW – please enter them from the aircraft's manual.");
        });
    }

    private void NameChanged(string name)
    {
        _form.Name = name;
        if (!_idTouched) _form.Id = AircraftProfileEstimator.Slug(name);
    }

    private void Estimate()
    {
        if (Reference is not { } r) return;
        // Rebuild the form from the filled profile; extra tags are already merged into its tag list.
        var stations = _form.Stations;
        _form = ProfileForm.From(AircraftProfileEstimator.FillFrom(Preview, r));
        _form.Stations = stations;
        Snackbar.Add(F("Empty values estimated from “{0}” (scaled by MTOW).", r.Name), Severity.Info);
    }

    private Task StationsFromSim() => Run(async () =>
    {
        var snap = await Monitor.Inspector!.ReadAircraftAsync();
        var draft = ProfileDraftBuilder.Build(snap, []);
        _form.Stations = ProfileForm.From(draft).Stations;
        Snackbar.Add(F("{0} stations taken from the sim.", _form.Stations.Count), Severity.Info);
    });

    private void AddStation() =>
        _form.Stations.Add(new ProfileForm.StationRow { Index = _form.Stations.Select(s => s.Index).DefaultIfEmpty(0).Max() + 1, Name = "Station" });

    private async Task Save()
    {
        var profile = Preview;
        bool overwritesOther = !profile.Id.Equals(_originalId, StringComparison.OrdinalIgnoreCase) &&
                               Store.Current.Aircraft.Any(a => a.Id.Equals(profile.Id, StringComparison.OrdinalIgnoreCase));
        if (overwritesOther &&
            await Dialogs.ShowMessageBoxAsync(T("ID already taken"), F("A profile “{0}” already exists. Replace it?", profile.Id), yesText: T("Replace"), cancelText: T("Cancel")) != true)
            return;
        if (_originalId is not null && !profile.Id.Equals(_originalId, StringComparison.OrdinalIgnoreCase) && await Career.IsProfileInUseAsync(_originalId))
        {
            Snackbar.Add(T("The ID can't be changed because aircraft in a career use this profile."), Severity.Warning);
            return;
        }

        await Run(async () =>
        {
            await Store.SaveAircraftAsync(profile, _originalId);
            Nav.NavigateTo("aircraft");
        }, F("“{0}” saved.", profile.Name));
    }

    private static string SurfaceText(RunwaySurface s) => s switch
    {
        RunwaySurface.Paved => T("Asphalt/concrete"),
        RunwaySurface.Gravel => T("Gravel"),
        RunwaySurface.Grass => T("Grass"),
        RunwaySurface.Dirt => T("Dirt/sand"),
        RunwaySurface.Water => T("Water"),
        RunwaySurface.Snow => T("Snow/ice"),
        _ => s.ToString()
    };
}
