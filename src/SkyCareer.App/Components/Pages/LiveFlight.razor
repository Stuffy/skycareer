@page "/live"
@implements IDisposable
@inject FlightMonitorService Monitor
@inject DepartureCoordinator Departure
@inject AppSettings Settings
@using SkyCareer.Missions.Settlement

<MudText Typo="Typo.h5" Class="mb-4">@T("Live flight")</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText>@T("Source:") <b>@Monitor.SourceName</b> – @Monitor.Connection</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!Monitor.LiveAvailable)" OnClick="ConnectLive">
            @T("Connect to MSFS")
        </MudButton>
        @if (Settings.DebugMode)
        {
            <MudTextField @bind-Value="_replayPath" Label="@T("Replay file (.jsonl)")" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:320px" />
            <MudButton Variant="Variant.Outlined" OnClick="StartReplay">@T("Start replay")</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => Monitor.BeginFlight()">@T("Start test tracking")</MudButton>
        }
    </MudStack>
    @if (!Monitor.LiveAvailable)
    {
        <MudAlert Severity="Severity.Info" Class="mt-2">
            @T("This build has no SimConnect support. Install the MSFS 2024 SDK and rebuild – until then replay mode works.")
        </MudAlert>
    }
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
    }
</MudPaper>

@if (Monitor.ContractId is { } jobId)
{
    var readiness = Departure.Automation.Readiness.GetValueOrDefault(jobId);
    <MudPaper Class="pa-3 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            @if (readiness is not null)
            {
                <span class="@MissionTexts.LightClass(readiness.Overall) sc-light-big"></span>
                <MudText><b>@F("Departure check: {0}", MissionTexts.LightText(readiness.Overall))</b></MudText>
                <MudText Typo="Typo.body2" Class="ml-2">
                    @string.Join(" · ", readiness.Items.Where(i => i.Light is SkyCareer.Missions.Departure.Light.Red or SkyCareer.Missions.Departure.Light.Yellow).Select(i => i.Label))
                </MudText>
            }
            else
            {
                <MudText><b>@T("Job in flight")</b></MudText>
            }
            <MudSpacer />
            <MudText>@T("Phase:") <b>@MissionTexts.Phase(Monitor.Phase)</b></MudText>
        </MudStack>
        @if (Departure.Automation.Waiting is { } waiting)
        {
            <MudAlert Severity="Severity.Info" Class="mt-2" ContentAlignment="HorizontalAlignment.Left">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.body2">@F("{0} – the GSX receipts then belong to the settlement.", waiting)</MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => SettleNow(jobId)">@T("Settle now")</MudButton>
                </MudStack>
            </MudAlert>
        }
    </MudPaper>
}

@if (Settings.DebugMode && Monitor.HasSession)
{
    <MudPaper Class="pa-3 mb-4" Style="border:1px dashed var(--mud-palette-warning)">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.BugReport" Color="Color.Warning" />
            <MudText><b>@T("Debug: set flight phase")</b></MudText>
            <MudSpacer />
            <MudSwitch T="bool" Value="Monitor.PhaseFrozen" ValueChanged="SetFrozen" Color="Color.Warning"
                       Label="@T("Freeze phase (telemetry doesn't change it)")" />
        </MudStack>
        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
            @foreach (var phase in Enum.GetValues<FlightPhase>())
            {
                <MudButton Size="Size.Small" Variant="@(Monitor.Phase == phase ? Variant.Filled : Variant.Outlined)"
                           Color="@(Monitor.Phase == phase ? Color.Warning : Color.Default)" OnClick="() => SetPhase(phase)">
                    @MissionTexts.Phase(phase)
                </MudButton>
            }
        </MudStack>
        <MudText Typo="Typo.caption" Class="mt-2" Style="display:block">
            @T("Flight automation reacts as if the phase had been detected: climb starts an accepted job, “Parked” settles it (as arrival or diversion depending on the position). Without “freeze” the telemetry resumes detecting by itself afterwards. The settlement notes manual phase changes.")
        </MudText>
    </MudPaper>
}

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">@T("Telemetry")</MudText>
            @if (Monitor.Latest is { } t)
            {
                <MudSimpleTable Dense="true">
                    <tbody>
                        <tr><td>@T("Aircraft")</td><td>@t.AircraftTitle</td></tr>
                        <tr><td>@T("Position")</td><td class="mono">@t.Latitude.ToString("0.0000"), @t.Longitude.ToString("0.0000")</td></tr>
                        <tr><td>@T("Altitude / AGL")</td><td>@t.AltitudeFt.ToString("N0") ft / @t.AltitudeAglFt.ToString("N0") ft</td></tr>
                        <tr><td>GS / IAS</td><td>@t.GroundSpeedKt.ToString("N0") kt / @t.IndicatedAirspeedKt.ToString("N0") kt</td></tr>
                        <tr><td>V/S</td><td>@t.VerticalSpeedFpm.ToString("N0") fpm</td></tr>
                        <tr><td>@T("Fuel")</td><td>@t.FuelKg.ToString("N0") kg</td></tr>
                        <tr><td>@T("Payload")</td><td>@t.PayloadKg.ToString("N0") kg</td></tr>
                        <tr><td>@T("Gross weight")</td><td>@t.TotalWeightKg.ToString("N0") kg</td></tr>
                        <tr>
                            <td>@T("On ground / parking brake")</td>
                            <td>
                                @(t.OnGround ? T("yes") : T("no")) / @(t.ParkingBrake ? T("set") : T("released"))
                                @if (Monitor.Phase == FlightPhase.TaxiIn && !t.ParkingBrake)
                                {
                                    <br /><MudText Typo="Typo.caption">@T("If the aircraft reports no parking brake (e.g. Fenix), it counts as parked after 30 s stationary with the engines shut down.")</MudText>
                                }
                            </td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            }
            else
            {
                <MudText Typo="Typo.body2">@T("No data yet.")</MudText>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">@T("Flight")</MudText>
            @if (Monitor.Summarize() is { } sum)
            {
                <MudSimpleTable Dense="true">
                    <tbody>
                        <tr><td>@T("Phase")</td><td><b>@sum.FinalPhase</b></td></tr>
                        <tr><td>Block-Off / Takeoff</td><td>@Time(sum.BlockOff) / @Time(sum.TakeoffTime)</td></tr>
                        <tr><td>@T("Landing / Block-On")</td><td>@Time(sum.LandingTime) / @Time(sum.BlockOn)</td></tr>
                        <tr><td>@T("Distance")</td><td>@sum.DistanceFlownNm.ToString("N1") nm</td></tr>
                        <tr><td>@T("Fuel burn")</td><td>@sum.FuelUsedKg.ToString("N0") kg</td></tr>
                        <tr><td>G min / max</td><td>@sum.MinGForce.ToString("N2") / @sum.MaxGForce.ToString("N2")</td></tr>
                        @if (sum.FinalTouchdown is { } td)
                        {
                            <tr><td>@T("Touchdown")</td><td>@F("{0:N0} fpm, {1:N2} G, {2} bounce(s)", td.VerticalSpeedFpm, td.GForce, td.Bounces)</td></tr>
                        }
                        <tr>
                            <td>@T("Violations")</td>
                            <td class="@(sum.Violations.Count == 0 ? "ok" : "bad")">
                                @if (sum.Violations.Count == 0)
                                {
                                    <span>@T("none")</span>
                                }
                                else
                                {
                                    var violations = sum.Violations.Select(v => new RuleViolation(FlightResultMapper.Type(v.Kind), v.Detail)).ToList();
                                    var penalties = FlightSettlement.ViolationPenalties(violations);
                                    @string.Join(", ", violations.Select(v => v.Type).Distinct().Select(k => FlightSettlement.ViolationText(k) +
                                        (penalties.FirstOrDefault(p => p.Type == k) is { Share: > 0 } p ? F(" (−{0:P0} pay)", p.Share) : T(" (noted only)"))))
                                }
                            </td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            }
            else
            {
                <MudText Typo="Typo.body2">@T("No active flight. An accepted job is tracked automatically as soon as the aircraft is at the departure airport.")@(Settings.DebugMode ? T(" “Start test tracking” tracks a flight without a job.") : "")</MudText>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">@T("Events")</MudText>
            @foreach (var line in Monitor.EventLog.Take(50))
            {
                <div class="mono">@line</div>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private string _replayPath = "";
    private string? _error;

    protected override void OnInitialized()
    {
        Monitor.Changed += OnChanged;
        Settings.Changed += OnChanged;
    }

    // Telemetry arrives ~4×/s from a background thread; marshal to the renderer.
    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task ConnectLive() => await Run(Monitor.ConnectLiveAsync);

    private void SetPhase(FlightPhase phase)
    {
        Monitor.ForcePhase(phase, Monitor.PhaseFrozen);
        Departure.TickNow(); // don't wait for the next telemetry sample
    }

    private void SetFrozen(bool freeze)
    {
        if (Monitor.Phase is { } phase) Monitor.ForcePhase(phase, freeze);
    }

    private void SettleNow(Guid jobId)
    {
        Departure.Automation.SettleNow(jobId);
        Departure.TickNow();
    }

    private async Task StartReplay() => await Run(() => Monitor.StartReplayAsync(_replayPath, speed: 10));

    private async Task Run(Func<Task> action)
    {
        _error = null;
        try { await action(); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private static string Time(DateTimeOffset? t) => t?.ToLocalTime().ToString("HH:mm:ss") ?? "–";

    public void Dispose()
    {
        Monitor.Changed -= OnChanged;
        Settings.Changed -= OnChanged;
    }
}
