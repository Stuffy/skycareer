<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Translations keyed by the English source text: <language>/<area>.json, merged at load. -->
    <EmbeddedResource Include="*\*.json" LogicalName="SkyCareer.Localization.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
