@page "/settings"
@using SkyCareer.Domain.Loading
@inherits CareerPageBase
@inject HttpClient Http
@inject GsxCoordinator Gsx
@inject UpdateService Updates
@inject AppSettings AppSettings
@inject Diagnostics Diag

<MudText Typo="Typo.h5" Class="mb-4">@T("Settings")</MudText>

@if (_career is { } c)
{
    <MudPaper Class="pa-4 mb-4" Style="max-width:720px">
        <MudText Typo="Typo.h6" Class="mb-2">@T("Career")</MudText>
        <MudSimpleTable Dense="true">
            <tbody>
                <tr><td>@T("Airline")</td><td>@c.AirlineName</td></tr>
                <tr><td>@T("Pilot")</td><td>@c.Name</td></tr>
                <tr><td>@T("Home base")</td><td>@c.HomeBase</td></tr>
                <tr><td>@T("Difficulty")</td><td>@(c.Difficulty switch { Difficulty.Easy => T("Easy"), Difficulty.Hard => T("Hard"), _ => T("Normal") })</td></tr>
                <tr><td>@T("Created")</td><td>@c.CreatedAtUtc.ToLocalTime().ToString("d")</td></tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Style="max-width:720px">
        <MudText Typo="Typo.h6" Class="mb-2">@T("Integrations")</MudText>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudTextField @bind-Value="_simBriefUser" Label="@T("SimBrief username or pilot ID")" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudButton Variant="Variant.Outlined" Disabled="Busy" OnClick="SaveSimBrief">@T("Save")</MudButton>
        </MudStack>
        <MudSwitch T="bool" Value="c.GsxSyncEnabled" ValueChanged="SetGsxSync" Color="Color.Primary" Class="mt-3"
                   Label="@T("Sync loading with GSX (when GSX Pro is running)")" />
        <MudSwitch T="bool" Value="c.GsxCostsEnabled" ValueChanged="SetGsxCosts" Color="Color.Primary" Class="mt-1"
                   Label="@T("Use GSX receipts as costs")" />
        <MudText Typo="Typo.caption" Style="display:block">
            @T("Handling, buses, catering and refuelling are booked with the amounts from the GSX bills (converted to euros); the model costs for them are dropped at settlement. Fuel uplifted without GSX is then free. Only receipts from the moment this is switched on count.")
        </MudText>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Style="max-width:720px">
        <MudText Typo="Typo.h6" Class="mb-2">@T("Loading")</MudText>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudNumericField T="double" @bind-Value="_paxWeightLb" Label="@T("Weight per passenger (lbs)")" Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="@(Math.Round(CareerService.MinPassengerWeightKg * LbPerKg))" Max="@(Math.Round(CareerService.MaxPassengerWeightKg * LbPerKg))"
                             HelperText="@($"= {_paxWeightLb / LbPerKg:N1} kg")" Style="max-width:200px" />
            <MudNumericField T="double" @bind-Value="_bagWeightLb" Label="@(c.SimBriefDetailedLoad ? T("Avg. weight per bag (lbs)") : T("Weight per bag (lbs)"))" Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="0" Max="@(Math.Round(CareerService.MaxBagWeightKg * LbPerKg))"
                             HelperText="@($"= {_bagWeightLb / LbPerKg:N1} kg")" Style="max-width:200px" />
            <MudButton Variant="Variant.Outlined" Disabled="Busy" OnClick="SaveWeights">@T("Save")</MudButton>
            <MudButton Variant="Variant.Text" Disabled="Busy" OnClick="ResetWeights">@T("SimBrief default (175 / 50 lbs)")</MudButton>
        </MudStack>
        <MudText Typo="Typo.body2" Class="mt-2">
            @T("Every passenger (children too) counts with this weight and has one bag, except on hand-luggage-only jobs – SimBrief calculates the same way.")
            @T("SimBrief splits the payload with the weights of your SimBrief airframe; with the same values here, passengers, bags and freight in the OFP match the job as well.")
            @T("Applies to new jobs; jobs already offered or accepted keep their weights.")
            @T("SimBrief gets the exact zero fuel weight of the load sheet and adjusts the freight in the OFP to match.")
        </MudText>
        <MudSwitch T="bool" Value="c.PersistFuel" ValueChanged="SetPersistFuel" Color="Color.Primary" Class="mt-3"
                   Label="@T("Keep fuel on board between flights")" />
        <MudText Typo="Typo.caption" Style="display:block">
            @T("The remaining fuel stays in the aircraft after parking and is set in the sim when the next job is armed (once per job, before taxiing). You then only pay for the fuel uplifted up to block-off instead of the burn.")
        </MudText>
        <MudSwitch T="bool" Value="c.SimBriefDetailedLoad" ValueChanged="SetDetailedLoad" Color="Color.Primary" Class="mt-3"
                   Label="@T("Varying bag weights per passenger")" />
        <MudText Typo="Typo.caption" Style="display:block">
            @T("Bags weigh differently per passenger (the value above is the average), and some passengers travel without checked bags. Applies to new jobs.")
        </MudText>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Style="max-width:720px">
        <MudText Typo="Typo.h6" Class="mb-2">Updates</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            @T("Installed version:") <b>@Updates.CurrentVersion</b> –
            @(Updates.Status switch
            {
                UpdateStatus.Disabled => T("development build, updates only in the installed app"),
                UpdateStatus.Checking => T("checking for updates …"),
                UpdateStatus.Downloading => F("downloading version {0} ({1} %)", Updates.AvailableVersion, Updates.Progress),
                UpdateStatus.Ready => F("version {0} is ready and will be installed on restart", Updates.AvailableVersion),
                UpdateStatus.Error => F("update check failed: {0}", Updates.Error),
                _ => Updates.LastCheckUtc is { } t ? F("up to date (checked {0:HH:mm})", t.ToLocalTime()) : T("up to date")
            })
        </MudText>
        @if (Updates.Status == UpdateStatus.Downloading)
        {
            <MudProgressLinear Value="Updates.Progress" Class="mb-2" />
        }
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined" Disabled="@(Updates.Status is UpdateStatus.Disabled or UpdateStatus.Checking or UpdateStatus.Downloading or UpdateStatus.Ready)"
                       OnClick="CheckUpdates">@T("Check for updates")</MudButton>
            @if (Updates.Status == UpdateStatus.Ready)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!Updates.CanRestartNow)" OnClick="RestartForUpdate">@T("Restart and install")</MudButton>
            }
            @if (!string.IsNullOrEmpty(Updates.RepoUrl))
            {
                <MudButton Variant="Variant.Text" Href="@($"{Updates.RepoUrl}/releases")" Target="_blank">@T("All versions")</MudButton>
            }
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Style="max-width:720px">
        <MudText Typo="Typo.h6" Class="mb-2">@T("Language")</MudText>
        <LanguageSelect />
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Style="max-width:720px">
        <MudText Typo="Typo.h6" Class="mb-2">@T("Advanced")</MudText>
        <MudSwitch T="bool" Value="AppSettings.DebugMode" ValueChanged="AppSettings.SetDebugMode" Color="Color.Warning"
                   Label="@T("Enable debug mode")" />
        <MudText Typo="Typo.body2" Class="mt-1">
            @T("Shows the “Debug” menu with developer and cheat tools (balance, reputation, fleet, jobs) as well as replay and free relocation. Changes to the balance are recorded in the ledger as adjustments.")
        </MudText>
        <MudText Typo="Typo.subtitle2" Class="mt-4">@T("Report a problem")</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            @T("The app writes an error log. “Copy diagnostics” puts the version, simulator status and the latest log lines on the clipboard – just paste them into your bug report.")
        </MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" Disabled="Busy" OnClick="CopyDiagnostics">@T("Copy diagnostics")</MudButton>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="Diagnostics.OpenLogFolder">@T("Open log folder")</MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4" Style="max-width:720px">
        <MudText Typo="Typo.h6" Class="mb-2">@T("Airport data")</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">@F("{0:N0} airports from OurAirports, cities from GeoNames (CC BY 4.0). Updating downloads the current data again (approx. 18 MB).", _airportCount)</MudText>
        <MudButton Variant="Variant.Outlined" Disabled="Busy" OnClick="ImportAirports">@T("Update airport data")</MudButton>
        @if (_importing)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-2" />
        }
    </MudPaper>
}

@code {
    private Career? _career;
    private string? _simBriefUser;
    private int _airportCount;
    private bool _importing;
    private double _paxWeightLb, _bagWeightLb;
    private bool _weightsLoaded;
    private const double LbPerKg = 2.20462;

    protected override void OnInitialized() => Updates.Changed += OnUpdatesChanged;

    private void OnUpdatesChanged() => InvokeAsync(StateHasChanged);

    public override void Dispose()
    {
        Updates.Changed -= OnUpdatesChanged;
        base.Dispose();
    }

    private Task CheckUpdates() => Updates.CheckAndDownloadAsync();

    private Task CopyDiagnostics() => Run(Diag.CopyReportAsync, T("Diagnostics copied to the clipboard."));

    private Task RestartForUpdate() => Run(() =>
    {
        Updates.RestartAndApply();
        return Task.CompletedTask;
    });

    protected override async Task LoadAsync()
    {
        _career = await Career.GetCareerAsync();
        _simBriefUser ??= _career.SimBriefUser;
        if (!_weightsLoaded)
        {
            _paxWeightLb = Math.Round(_career.PassengerWeightKg * LbPerKg, 1);
            _bagWeightLb = Math.Round(_career.BagWeightKg * LbPerKg, 1);
            _weightsLoaded = true;
        }
        _airportCount = await Career.AirportCountAsync();
    }

    private Task SaveSimBrief() => Run(() => Career.UpdateSimBriefUserAsync(_simBriefUser), T("Saved."));

    private Task SaveWeights() => Run(() => Career.UpdateLoadWeightsAsync(_paxWeightLb / LbPerKg, _bagWeightLb / LbPerKg), T("Saved."));

    private Task ResetWeights()
    {
        _paxWeightLb = 175;
        _bagWeightLb = 50;
        return Run(() => Career.UpdateLoadWeightsAsync(PassengerMassTable.SimBriefAdultKg, PassengerMassTable.SimBriefBagKg), T("Saved."));
    }

    private Task SetGsxSync(bool enabled) => Run(async () =>
    {
        await Career.UpdateGsxSyncAsync(enabled);
        Gsx.SetSyncEnabled(enabled);
    });

    private Task SetPersistFuel(bool enabled) => Run(() => Career.UpdatePersistFuelAsync(enabled));

    private Task SetDetailedLoad(bool enabled) => Run(() => Career.UpdateSimBriefDetailedLoadAsync(enabled));

    private Task SetGsxCosts(bool enabled) => Run(() => Career.UpdateGsxCostsAsync(enabled));

    private Task ImportAirports() => Run(async () =>
    {
        _importing = true;
        try
        {
            int n = await AirportDownloader.DownloadAndImportAsync(Http, Career);
            Snackbar.Add(F("{0:N0} airports imported.", n), Severity.Success);
        }
        finally
        {
            _importing = false;
        }
    });
}
