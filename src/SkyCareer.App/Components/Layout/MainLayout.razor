@inherits LayoutComponentBase
@implements IDisposable
@inject CareerService Career
@inject NavigationManager Nav
@inject GsxCoordinator Gsx
@inject AppSettings Settings

<MudThemeProvider IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (Career.ActiveCareerId is null)
{
    <CareerSelect />
}
else
{
    <MudLayout>
        <MudAppBar Elevation="1" Dense="true">
            <MudText Typo="Typo.h6" Class="mr-6">SkyCareer</MudText>
            <CareerStatus />
            <MudSpacer />
            <MudTooltip Text="@T("Switch career")">
                <MudIconButton Icon="@Icons.Material.Filled.SwitchAccount" Color="Color.Inherit" OnClick="SwitchCareer" aria-label="@T("Switch career")" />
            </MudTooltip>
        </MudAppBar>
        <MudDrawer Open="true" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="DrawerVariant.Persistent">
            <MudNavMenu>
                <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Assignment">@T("Jobs")</MudNavLink>
                <MudNavLink Href="airline" Icon="@Icons.Material.Filled.Business">@T("Airline")</MudNavLink>
                <MudNavLink Href="fleet" Icon="@Icons.Material.Filled.AirplanemodeActive">@T("Fleet")</MudNavLink>
                <MudNavLink Href="finance" Icon="@Icons.Material.Filled.AccountBalance">@T("Finances")</MudNavLink>
                <MudNavLink Href="logbook" Icon="@Icons.Material.Filled.MenuBook">@T("Logbook")</MudNavLink>
                <MudNavLink Href="live" Icon="@Icons.Material.Filled.FlightTakeoff">@T("Live Flight")</MudNavLink>
                <MudDivider Class="my-2" />
                <MudNavGroup Title="@T("Content")" Icon="@Icons.Material.Filled.LibraryBooks">
                    <MudNavLink Href="aircraft" Icon="@Icons.Material.Filled.Tune">@T("Aircraft Profiles")</MudNavLink>
                    <MudNavLink Href="missions" Icon="@Icons.Material.Filled.Category">@T("Mission Types")</MudNavLink>
                </MudNavGroup>
                @if (Settings.DebugMode)
                {
                    <MudNavGroup Title="Debug" Icon="@Icons.Material.Filled.BugReport" Expanded="true">
                        <MudNavLink Href="debug" Icon="@Icons.Material.Filled.Build">@T("Debug Tools")</MudNavLink>
                        <MudNavLink Href="spike" Icon="@Icons.Material.Filled.Scale">@T("Loading Spike")</MudNavLink>
                    </MudNavGroup>
                }
                <MudNavLink Href="settings" Icon="@Icons.Material.Filled.Settings">@T("Settings")</MudNavLink>
            </MudNavMenu>
        </MudDrawer>
        @* No padding class on MudMainContent itself: its padding-top reserves room for the app bar,
           and a utility like pa-4 (!important) would override it and push pages under the bar. *@
        <MudMainContent>
            <div class="pa-4">
                <UpdateBanner />
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="ex">
                        @{ LogPageError(ex); }
                        <MudAlert Severity="Severity.Error" Class="mb-3">
                            <MudText><b>@T("An error occurred here:")</b> @ex.Message</MudText>
                            <MudText Typo="Typo.body2" Class="mt-1">@T("Details are in the error log. You can report the error via “Settings → Advanced → Copy diagnostics”.")</MudText>
                            <MudStack Row="true" Spacing="2" Class="mt-2">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="RecoverFromError">@T("Continue")</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="Diagnostics.OpenLogFolder">@T("Open log folder")</MudButton>
                            </MudStack>
                        </MudAlert>
                    </ErrorContent>
                </ErrorBoundary>
            </div>
        </MudMainContent>
    </MudLayout>
}

@code {
    private ErrorBoundary? _errorBoundary;
    private Exception? _loggedError;

    // ErrorContent renders repeatedly; log each exception once.
    private void LogPageError(Exception ex)
    {
        if (ReferenceEquals(ex, _loggedError)) return;
        _loggedError = ex;
        AppLog.Error("UI", $"Error on page {Nav.Uri}", ex);
    }

    private void RecoverFromError()
    {
        _errorBoundary?.Recover();
        Nav.NavigateTo("");
    }

    protected override void OnInitialized()
    {
        Career.Changed += OnCareerChanged;
        Settings.Changed += OnCareerChanged;
    }

    // Re-render when a career is selected or left so the selection screen and the app swap.
    private void OnCareerChanged() => InvokeAsync(StateHasChanged);

    private void SwitchCareer()
    {
        Gsx.Stop(); // GSX polling belongs to a job of the career being left
        Career.ClearSelection();
        Nav.NavigateTo("");
    }

    public void Dispose()
    {
        Career.Changed -= OnCareerChanged;
        Settings.Changed -= OnCareerChanged;
    }
}
