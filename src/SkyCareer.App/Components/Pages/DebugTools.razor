@page "/debug"
@inherits CareerPageBase
@using System.Diagnostics
@using SkyCareer.Data
@using SkyCareer.Integrations.BeyondAtc
@inject FlightMonitorService Monitor
@inject UpdateService Updates

<DebugGate>
<MudText Typo="Typo.h5" Class="mb-1">@T("Debug Tools")</MudText>
<MudText Typo="Typo.body2" Class="mb-4">@T("For testing and corrections. Changes apply to the active career immediately.")</MudText>

@if (_career is { } c)
{
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Style="height:100%">
                <MudText Typo="Typo.h6" Class="mb-2">@T("Career")</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">@T("Balance:") <b>@Eur(c.Cash)</b> · @T("Reputation:") <b>@c.Reputation</b></MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudNumericField T="decimal" @bind-Value="_cash" Label="@T("Balance (€)")" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0" Style="max-width:200px" />
                    <MudButton Variant="Variant.Outlined" Disabled="Busy" OnClick="() => SetCash(_cash)">@T("Set")</MudButton>
                    <MudButton Variant="Variant.Text" Disabled="Busy" OnClick="() => SetCash(c.Cash + 100_000)">+@Eur(100_000m)</MudButton>
                    <MudButton Variant="Variant.Text" Disabled="Busy" OnClick="() => SetCash(c.Cash + 1_000_000)">@T("+1 million €")</MudButton>
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3">
                    <MudSlider T="int" @bind-Value="_reputation" Min="0" Max="100" Step="1" Style="max-width:260px">@T("Reputation:") @_reputation</MudSlider>
                    <MudButton Variant="Variant.Outlined" Disabled="Busy" OnClick="SetReputation">@T("Set")</MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Style="height:100%">
                <MudText Typo="Typo.h6" Class="mb-2">@T("Diagnostics")</MudText>
                <MudSimpleTable Dense="true">
                    <tbody>
                        <tr><td>@T("Version")</td><td>@Updates.CurrentVersion@(Updates.Status == UpdateStatus.Disabled ? " " + T("(development build)") : "")</td></tr>
                        <tr><td>@T("Simulator")</td><td>@Monitor.SourceName – @Monitor.Connection, @T("Phase") @(Monitor.Phase is { } p ? MissionTexts.Phase(p) : "–")</td></tr>
                        <tr><td>@T("Game time")</td><td>@c.GameTime.ToString("g") UTC</td></tr>
                        @foreach (var (label, path) in Folders)
                        {
                            <tr>
                                <td>@label</td>
                                <td class="mono" style="word-break:break-all">
                                    @path
                                    <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" OnClick="() => OpenFolder(path)" aria-label="@T("Open folder")" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">@T("Fleet")</MudText>
                @if (_fleet.Count == 0)
                {
                    <MudText Typo="Typo.body2">@T("No aircraft.")</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true">
                        <thead><tr><th>@T("Aircraft")</th><th>@T("Location")</th><th>@T("Condition")</th><th>@T("Status")</th><th>@T("Actions")</th></tr></thead>
                        <tbody>
                            @foreach (var a in _fleet)
                            {
                                var edit = _edits[a.Id];
                                <tr>
                                    <td>@a.Registration<br /><small>@Career.ProfileName(a.ProfileId)</small></td>
                                    <td>@a.Location</td>
                                    <td>@a.Condition.ToString("N0") %</td>
                                    <td>@(a.IsAvailable(c.GameTime) ? T("available") : F("{0} until {1:g}", a.UnavailableReason ?? T("Maintenance"), a.UnavailableUntil))</td>
                                    <td>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                                            <MudNumericField T="double" @bind-Value="edit.Condition" Min="0" Max="100" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:90px" />
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="Busy" OnClick="() => SetCondition(a, edit.Condition)">@T("Set condition")</MudButton>
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(Busy || a.IsAvailable(c.GameTime))" OnClick="() => ClearDowntime(a)">@T("End maintenance")</MudButton>
                                            <MudTextField T="string" @bind-Value="edit.Location" Placeholder="ICAO" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:90px" />
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(Busy || string.IsNullOrWhiteSpace(edit.Location))" OnClick="() => Move(a, edit.Location)">@T("Relocate (free)")</MudButton>
                                        </MudStack>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.h6">@T("Jobs")</MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined" Disabled="Busy" OnClick="ResetMarket">@T("Clear and regenerate market")</MudButton>
                </MudStack>
                @if (_jobs.Count == 0)
                {
                    <MudText Typo="Typo.body2">@T("No accepted or active jobs.")</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true">
                        <thead><tr><th>@T("Route")</th><th>@T("Status")</th><th>@T("Deadline")</th><th>@T("Payout")</th><th>@T("Actions")</th></tr></thead>
                        <tbody>
                            @foreach (var j in _jobs)
                            {
                                <tr>
                                    <td>@j.Origin → @j.Destination (@j.DistanceNm.ToString("N0") nm)</td>
                                    <td>@(j.Status == ContractStatus.InProgress ? T("In flight") : T("Accepted"))</td>
                                    <td>@j.Deadline.ToString("dd.MM. HH:mm")</td>
                                    <td>@Eur(j.Payout)</td>
                                    <td>
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" Disabled="Busy" OnClick="() => Complete(j)">@T("Complete successfully now")</MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="Busy" OnClick="() => ExtendDeadline(j)">@T("Deadline +24 h")</MudButton>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}
</DebugGate>

@code {
    private Career? _career;
    private List<FleetAircraft> _fleet = [];
    private List<MissionContract> _jobs = [];
    private readonly Dictionary<Guid, AircraftEdit> _edits = [];
    private decimal _cash;
    private int _reputation;

    private sealed class AircraftEdit
    {
        public double Condition { get; set; }
        public string? Location { get; set; }
    }

    private static IEnumerable<(string, string)> Folders =>
    [
        (T("Database"), Path.GetDirectoryName(SkyCareerDb.DefaultPath)!),
        (T("Own content"), ContentStore.DefaultUserRoot),
        (T("Flight plans"), PlnExporter.DefaultDirectory),
        (T("Flight recordings"), FlightMonitorService.TracksDirectory),
        (T("Error log"), App.LogDirectory)
    ];

    protected override async Task LoadAsync()
    {
        _career = await Career.GetCareerAsync();
        _cash = _career.Cash;
        _reputation = _career.Reputation;
        _fleet = (await Career.GetFleetAsync()).OrderBy(f => f.Registration).ToList();
        foreach (var a in _fleet)
            _edits[a.Id] = new AircraftEdit { Condition = Math.Round(a.Condition) };
        _jobs = (await Career.GetContractsAsync(ContractStatus.Accepted, ContractStatus.InProgress)).OrderBy(j => j.Deadline).ToList();
    }

    private Task SetCash(decimal amount) => Run(() => Career.SetCashAsync(amount), F("Balance set to {0}.", Eur(amount)));

    private Task SetReputation() => Run(() => Career.SetReputationAsync(_reputation), F("Reputation set to {0}.", _reputation));

    private Task SetCondition(FleetAircraft a, double condition) =>
        Run(() => Career.DebugSetAircraftAsync(a.Id, condition: condition), F("{0}: condition {1:N0} %.", a.Registration, condition));

    private Task ClearDowntime(FleetAircraft a) =>
        Run(() => Career.DebugSetAircraftAsync(a.Id, clearDowntime: true), F("{0} is available again.", a.Registration));

    private Task Move(FleetAircraft a, string? location) =>
        Run(() => Career.DebugSetAircraftAsync(a.Id, location: location), F("{0} is now parked at {1}.", a.Registration, location?.Trim().ToUpperInvariant()));

    private Task Complete(MissionContract job) => Run(async () =>
    {
        // A tracked session for this job would otherwise try to settle it again.
        if (Monitor.ContractId == job.Id) Monitor.EndFlight();
        var result = await Career.DebugCompleteContractAsync(job.Id);
        Snackbar.Add(F("{0} → {1} settled: {2}, score {3:N0}, {4}.", job.Origin, job.Destination,
                     result.Outcome == FlightOutcome.Completed ? T("successful") : result.Outcome.ToString(), result.Score.Total,
                     Eur(result.Lines.Sum(l => l.Amount))), Severity.Success);
    });

    private Task ExtendDeadline(MissionContract job) =>
        Run(() => Career.DebugExtendDeadlineAsync(job.Id, TimeSpan.FromHours(24)), T("Deadline extended by 24 h."));

    private Task ResetMarket() => Run(async () =>
    {
        int removed = await Career.DebugClearMarketAsync();
        int created = await Career.RefreshMarketAsync();
        Snackbar.Add(F("{0} offers removed, {1} newly generated.", removed, created), Severity.Success);
    });

    private void OpenFolder(string path)
    {
        Directory.CreateDirectory(path);
        Process.Start(new ProcessStartInfo("explorer.exe", $"\"{path}\"") { UseShellExecute = true });
    }
}
