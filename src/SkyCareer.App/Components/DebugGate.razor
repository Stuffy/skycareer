@implements IDisposable
@inject AppSettings Settings

@* Renders its content only while the debug mode is on (pages under the "Debug" menu). *@
@if (Settings.DebugMode)
{
    @ChildContent
}
else
{
    <MudAlert Severity="Severity.Info">
        @T("Debug mode is off. Go to") <MudLink Href="settings">@T("Settings → Advanced")</MudLink> @T("to turn it on.")
    </MudAlert>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized() => Settings.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Settings.Changed -= OnChanged;
}
