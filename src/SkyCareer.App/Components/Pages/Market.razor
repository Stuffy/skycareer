@page "/"
@page "/market"
@inherits CareerPageBase
@using System.Diagnostics
@using SkyCareer.Domain.Loading
@using SkyCareer.Integrations.SimBrief
@using SkyCareer.Missions.Settlement
@inject FlightMonitorService Monitor
@inject SimBriefClient SimBrief
@inject IDialogService Dialogs
@inject GsxCoordinator Gsx
@inject DepartureCoordinator Departure
@using SkyCareer.Missions.Departure
@inject MarketFilter Filter
@inject IAirportIlsLookup IlsLookup
@using SkyCareer.Integrations.Gsx
@using SkyCareer.Integrations.BeyondAtc

<MudText Typo="Typo.h5" Class="mb-4">@T("Jobs")</MudText>

@if ((_settlement ?? Departure.Automation.LastSettlement) is { } s)
{
    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6">@F("Settlement: {0} – score {1}", OutcomeText(s.Outcome), s.Score.Total)</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Text" OnClick="CloseSettlement">@T("Close")</MudButton>
        </MudStack>
        <MudText Typo="Typo.body2" Class="mb-2">
            @F("Landing {0} · smoothness {1} · punctuality {2}", s.Score.Landing, s.Score.Smoothness, s.Score.Punctuality) @(s.Score.SafetyPenalty > 0 ? F("· safety deduction −{0}", s.Score.SafetyPenalty) : "")
            · @F("Reputation {0}{1} · now at {2}", s.ReputationChange >= 0 ? "+" : "", s.ReputationChange, s.FinalLocation)
        </MudText>
        @foreach (var n in s.Notes)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-1">@n</MudAlert>
        }
        <MudSimpleTable Dense="true">
            <tbody>
                @foreach (var l in s.Lines)
                {
                    <tr><td>@l.Description</td><td style="text-align:right" class="@(l.Amount < 0 ? "bad" : "ok")">@Eur(l.Amount)</td></tr>
                }
                <tr><td><b>@T("Result")</b></td><td style="text-align:right"><b>@Eur(s.Profit)</b></td></tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}

@foreach (var c in _active)
{
    var type = Career.MissionType(c.MissionTypeId);
    var aircraft = _fleet.FirstOrDefault(f => f.Id == c.AircraftId);
    var profile = aircraft is null ? null : Career.Profile(aircraft.ProfileId);
    var sheet = profile is null ? null : Career.BuildLoadSheet(c, profile);
    bool tracking = Monitor.ContractId == c.Id;
    var readiness = Departure.Automation.Readiness.GetValueOrDefault(c.Id);
    bool collapsible = IsWaitingReturn(c, aircraft);
    bool collapsed = collapsible && !_expanded.Contains(c.Id);

    <MudPaper Class="@(collapsed ? "pa-3 mb-4" : "pa-4 mb-4")" Elevation="3">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6">@type.DisplayName: @c.Origin → @c.Destination <span style="opacity:.7">· @Callsign(c)</span></MudText>
            <MudChip T="string" Size="Size.Small" Color="@(c.Status == ContractStatus.InProgress ? Color.Warning : tracking ? Color.Success : Color.Info)">@StatusText(c, tracking)</MudChip>
            @if (c.PackageLeg is { } leg)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" Icon="@Icons.Material.Filled.SyncAlt">
                    @(leg == 1 ? T("Outbound 1/2") : T("Return flight 2/2"))
                </MudChip>
            }
            <MudSpacer />
            <MudText>@Eur(c.Payout)</MudText>
            @if (collapsible)
            {
                <MudIconButton Size="Size.Small" Icon="@(collapsed ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                               title="@(collapsed ? T("Show details") : T("Collapse"))" OnClick="() => ToggleExpanded(c.Id)" />
            }
        </MudStack>
        @if (collapsed)
        {
            <MudText Typo="Typo.body2">
                @c.DistanceNm.ToString("N0") nm · @F("Deadline {0:dd.MM. HH:mm} UTC", c.Deadline) · @PaxText(c) · @F("starts after the outbound flight at {0}", c.Origin)
            </MudText>
        }
        else
        {
        <MudText Typo="Typo.body2" Class="mb-2">
            @aircraft?.Registration (@profile?.Name) · @c.DistanceNm.ToString("N0") nm · @F("Deadline {0:dd.MM. HH:mm} UTC", c.Deadline)
            · @PaxText(c) @(c.CargoKg > 0 ? F("· Cargo {0:N0} kg ({1})", c.CargoKg, c.CargoKind) : "")
        </MudText>

        @if (sheet is not null)
        {
            <MudText Typo="Typo.body2" Class="mb-2">
                @F("Load sheet: pax {0:N0} kg · baggage {1:N0} kg · cargo {2:N0} kg", sheet.PassengerMass.Kg, sheet.BaggageMass.Kg, sheet.CargoMass.Kg)
                · ZFW @sheet.ZeroFuelWeight.Kg.ToString("N0") kg · Block Fuel <b>@sheet.Fuel.Block.Kg.ToString("N0") kg</b>@(c.OfpBlockFuelKg is not null ? " (SimBrief)" : "")
                · TOW @sheet.TakeoffWeight.Kg.ToString("N0") / @sheet.Aircraft.MaxTakeoffKg.ToString("N0") kg
                @if (_persistFuel && aircraft?.FuelKg is { } inTank)
                {
                    <br />@F("In tanks {0:N0} kg → uplift {1:N0} kg", inTank, Math.Max(0, sheet.Fuel.Block.Kg - inTank))
                    @(c.FuelRestoredAtUtc is null && c.Status == ContractStatus.Accepted ? T(" (set in the sim when the job is armed)") : "")
                }
            </MudText>
        }
        @if (c.OfpRoute is not null)
        {
            <MudText Typo="Typo.caption" Class="mono mb-2 d-block">@T("Route:") @c.OfpRoute</MudText>
        }
        @if (_loadCheck.TryGetValue(c.Id, out var check))
        {
            <MudAlert Severity="@(check.Count == 0 ? Severity.Success : Severity.Error)" Dense="true" Class="mb-2">
                @(check.Count == 0 ? T("Sim loading matches the load sheet.") : string.Join(" · ", check.Select(d => F("{0}: planned {1:N0} kg, actual {2:N0} kg", d.Item, d.Expected.Kg, d.Actual.Kg))))
            </MudAlert>
        }
        @if (c.Status == ContractStatus.Accepted && readiness is not null && (!tracking || Monitor.Phase is FlightPhase.Preflight or FlightPhase.TaxiOut or FlightPhase.TakeoffRoll))
        {
            <MudPaper Outlined="true" Class="pa-3 mb-2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                    <span class="@MissionTexts.LightClass(readiness.Overall) sc-light-big"></span>
                    <MudText Typo="Typo.subtitle1"><b>@F("Departure check: {0}", MissionTexts.LightText(readiness.Overall))</b></MudText>
                    <MudSpacer />
                    <MudText Typo="Typo.caption">
                        @(tracking ? T("Tracked – changes are possible until liftoff, the job starts at liftoff.")
                                   : F("Starts automatically as soon as the aircraft is on the ground at {0}.", c.Origin))
                    </MudText>
                </MudStack>
                <table class="sc-checks">
                    @foreach (var item in readiness.Items)
                    {
                        <tr>
                            <td style="white-space:nowrap"><span class="@MissionTexts.LightClass(item.Light)"></span>@item.Label</td>
                            <td class="mud-typography-body2">@item.Detail</td>
                        </tr>
                    }
                </table>
                @if (readiness.Blocking.Any())
                {
                    <MudText Typo="Typo.caption" Class="bad d-block mt-1">@T("Red for position or aircraft type: the job will not start at liftoff.")</MudText>
                }
                else if (readiness.Penalised.Any())
                {
                    <MudText Typo="Typo.caption" Class="d-block mt-1">@T("Anything still red at liftoff costs 10 % of the payout each (at most 30 %).")</MudText>
                }
            </MudPaper>
        }
        @if (Departure.Automation.NotStarted.TryGetValue(c.Id, out var notStarted) && !tracking)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@F("Not started at the last liftoff: {0}", notStarted)</MudAlert>
        }
        @if (tracking && c.Status == ContractStatus.InProgress)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                @T("Flight phase:") <b>@MissionTexts.Phase(Monitor.Phase)</b> @T("– settled automatically after parking at the destination. Details under “Live flight”.")
                @if (Monitor.DepartureIssues.Count > 0)
                {
                    <br /><span>@F("Deviations at liftoff: {0}", string.Join("; ", Monitor.DepartureIssues))</span>
                }
            </MudAlert>
        }
        else if (c.Status == ContractStatus.InProgress)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@T("This flight is currently not being tracked (e.g. after an app restart).")</MudAlert>
        }
        @if (tracking && Departure.Automation.LastError is { } autoError)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@autoError</MudAlert>
        }

        @if (Gsx.ContractId == c.Id && Monitor.Connection == ConnectionState.Connected)
        {
            <MudPaper Outlined="true" Class="pa-2 mb-2">
                @if (Gsx.State is not { } g)
                {
                    <MudText Typo="Typo.body2">@T("GSX: querying …")</MudText>
                }
                else if (!g.Detected)
                {
                    <MudText Typo="Typo.body2">@T("GSX: not detected (not installed or Couatl not running).")</MudText>
                }
                else
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
                        <MudText Typo="Typo.body2"><b>GSX</b></MudText>
                        <MudText Typo="Typo.body2">Boarding: @GsxText(g.Boarding) @(g.PassengersBoardingTotal > 0 ? F("({0}/{1} pax, cargo {2:N0} %)", g.PassengersBoarded, g.PassengersBoardingTotal, g.CargoBoardingPercent) : "")</MudText>
                        <MudText Typo="Typo.body2">@T("Refuelling:") @GsxText(g.Refueling)</MudText>
                        <MudText Typo="Typo.body2">Pushback: @GsxText(g.Departure)</MudText>
                        <MudText Typo="Typo.body2">Deboarding: @GsxText(g.Deboarding) @(g.PassengersDeboardingTotal > 0 ? $"({g.PassengersDeboarded}/{g.PassengersDeboardingTotal})" : "")</MudText>
                        <MudSpacer />
                        <MudSwitch T="bool" Value="Gsx.SyncEnabled" ValueChanged="SetGsxSync" Color="Color.Primary"
                                   Disabled="@(sheet?.Aircraft.Loading != LoadingMethod.SimConnectStations)" Label="@T("Sync loading with GSX")" />
                    </MudStack>
                    @if (Gsx.Mismatch is { } mismatch)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">@mismatch</MudAlert>
                    }
                    @if (Gsx.LastAction is { } action)
                    {
                        <MudText Typo="Typo.caption" Class="d-block mt-1">@action</MudText>
                    }
                }
                @if (Gsx.LastError is { } gsxError)
                {
                    <MudText Typo="Typo.caption" Class="bad d-block">@gsxError</MudText>
                }
            </MudPaper>
        }

        @if (c.Status == ContractStatus.Accepted && PreparationSteps(c, type, profile, sheet) is { Count: > 0 } steps)
        {
            var next = steps.FirstOrDefault(s => !s.Done);
            <MudText Typo="Typo.subtitle2" Class="mt-1">@T("Preparation")</MudText>
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-1">
                @for (int i = 0; i < steps.Count; i++)
                {
                    var step = steps[i];
                    int number = i + 1;
                    if (i > 0)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                    }
                    <MudButton Size="Size.Small" Variant="@(step == next ? Variant.Filled : Variant.Outlined)" Color="@(step == next ? Color.Primary : Color.Default)"
                               StartIcon="@(step.Done ? Icons.Material.Filled.CheckCircle : null)" Disabled="@(Busy || step.Disabled)" OnClick="step.Action"
                               title="@step.Hint">@($"{number}. {step.Label}")</MudButton>
                }
            </MudStack>
            <MudText Typo="Typo.caption" Class="d-block mb-2">@T("Then take off in the simulator – the job starts automatically.")</MudText>
        }

        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            @if (c.Status == ContractStatus.Accepted)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="Busy" OnClick="() => ExportPlan(c, type)" StartIcon="@Icons.Material.Filled.Map"
                           title="@T("MSFS flight plan for BeyondATC (import ‘.PLN’) and the EFB in the sim")">@T("Flight plan (.pln)")</MudButton>
            }
            @if (c.Status == ContractStatus.Accepted && Monitor.HasSession && !tracking && Monitor.Phase is FlightPhase.Preflight or FlightPhase.TaxiOut)
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Disabled="Busy" OnClick="() => ChooseJob(c)">@T("Fly this job instead")</MudButton>
            }
            @if (c.Status == ContractStatus.InProgress)
            {
                @if (!tracking)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => ResumeTracking(c)">@T("Restart tracking")</MudButton>
                }
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(Busy || !tracking)" OnClick="() => Complete(c)"
                           title="@T("For an abort or diversion; after parking at the destination the flight is settled automatically.")">@T("Settle flight early")</MudButton>
            }
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="Busy" OnClick="() => Cancel(c)">@T("Cancel job")</MudButton>
        </MudStack>
        }
    </MudPaper>
}

<MarketFilterPanel Filter="Filter" Fleet="_fleet" MissionTypes="Career.Content.MissionTypes" IlsAvailable="IlsLookup.Available" Reputation="_reputation"
                   AirportDataOutdated="_airportDataOutdated" Busy="Busy" OnSearch="Search" OnFilterChanged="FilterChanged" />
@if (_searchStatus is not null)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">@_searchStatus</MudAlert>
}

@if (_fleet.Count > 0)
{
    <MudPaper Class="pa-2 mb-4">
        <MissionMap @ref="_map" Fleet="_fleetPoints" Routes="_routes" Live="_live" OnRouteSelected="SelectOffer"
                    OnShow="ShowOffer" OnAccept="AcceptFromMap" />
        <MudStack Row="true" Spacing="3" Class="mt-2 px-2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            @foreach (var (category, color) in CategoryColors)
            {
                <MudText Typo="Typo.caption"><span style="color:@color">━━</span> @MissionTexts.Category(category)</MudText>
            }
            <MudText Typo="Typo.caption"><span style="color:#4caf50">●</span> @T("Aircraft available") · <span style="color:#f44336">●</span> @T("in maintenance") · <span style="color:#ff9800">●</span> @T("Live position")</MudText>
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => _map!.FitAsync()">@T("Fit view")</MudButton>
        </MudStack>
    </MudPaper>
}

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Spacing="2">
        <MudText Typo="Typo.h6">@T("Offers")</MudText>
        @if (_offers.Count > 0)
        {
            <MudText Typo="Typo.body2">@F("{0} of {1}", VisibleOffers.Count(), _offers.Count)</MudText>
        }
        <MudTooltip Text="@T("New jobs pay more the better your reputation (up to +50 % at 100).")">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Star">
                @F("Reputation {0}: +{1:P0} pay", _reputation, SkyCareer.Missions.Generation.StandardMissionGenerator.ReputationFactor(_reputation) - 1)
            </MudChip>
        </MudTooltip>
        <MudSpacer />
        <MudText Typo="Typo.caption">@T("Click a column header to sort.")</MudText>
    </MudStack>
    @if (_fleet.Count == 0)
    {
        <MudText Typo="Typo.body2">@T("No aircraft, no jobs – get one under “Fleet”.")</MudText>
    }
    else if (_offers.Count == 0)
    {
        <MudText Typo="Typo.body2">@T("No offers. “Search jobs” creates new jobs at your aircraft's locations.")</MudText>
    }
    else if (!VisibleOffers.Any())
    {
        <MudText Typo="Typo.body2">@T("No offer matches the filters. “Search jobs” creates matching new jobs.")</MudText>
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true">
            <thead>
                <tr>
                    @SortHeader(OfferColumn.Aircraft, T("Aircraft"))
                    @SortHeader(OfferColumn.Mission, T("Job"))
                    @SortHeader(OfferColumn.Distance, T("Route"))
                    @SortHeader(OfferColumn.Runway, T("Destination"))
                    @SortHeader(OfferColumn.Load, T("Load"))
                    @SortHeader(OfferColumn.BlockFuel, T("Block fuel"))
                    @SortHeader(OfferColumn.Deadline, T("Deadline"))
                    @SortHeader(OfferColumn.Expires, T("Valid until"))
                    @SortHeader(OfferColumn.Payout, T("Payout"))
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in SortedOffers.Skip(_page * PageSize).Take(PageSize))
                {
                    var t = Career.MissionType(o.MissionTypeId);
                    <tr @onclick="() => SelectOffer(o.Id)" style="cursor:pointer; @(o.Id == _selected ? "background:rgba(255,255,255,0.08)" : "")" id="@($"offer-{o.Id:N}")">
                        @{ var plane = _fleet.FirstOrDefault(f => f.Id == o.AircraftId); var back = ReturnOf(o); }
                        <td>@plane?.Registration<br /><MudText Typo="Typo.caption">@(plane is null ? "" : Career.ProfileName(plane.ProfileId))</MudText></td>
                        <td><span style="color:@ColorFor(t)">●</span> @t.DisplayName<br /><MudText Typo="Typo.caption">@t.FlightRules · SimBrief @t.SimBrief</MudText></td>
                        <td>
                            @o.Origin → @o.Destination <MudText Typo="Typo.caption" Inline="true">@Callsign(o)</MudText>
                            @if (back is not null)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" Icon="@Icons.Material.Filled.SyncAlt" Class="ml-1">@T("Round trip")</MudChip>
                            }
                            <br /><MudText Typo="Typo.caption">@o.DistanceNm.ToString("N0") nm@(CityOf(o.Destination) is { Length: > 0 } city ? $" · {city}" : "")</MudText>
                            @if (back is not null)
                            {
                                <br /><MudText Typo="Typo.caption">@F("return: {0} pax · {1} · by {2:dd.MM. HH:mm}", back.TotalPassengers, Eur(back.Payout), back.Deadline)</MudText>
                            }
                        </td>
                        <td>@DestinationInfo(o.Destination)</td>
                        <td>@PaxText(o)@(o.CargoKg > 0 ? $", {o.CargoKg:N0} kg {o.CargoKind}" : "")</td>
                        <td>@o.PlannedBlockFuelKg.ToString("N0") kg</td>
                        <td>@o.Deadline.ToString("dd.MM. HH:mm")</td>
                        <td>@o.ExpiresAt.ToString("dd.MM. HH:mm")</td>
                        <td>
                            <b>@Eur(OfferValue(o))</b>
                            @if (back is not null)
                            {
                                <br /><MudText Typo="Typo.caption">@F("incl. return flight and {0} bonus", Eur(PackageBonus(o, back)))</MudText>
                            }
                        </td>
                        <td @onclick:stopPropagation="true"><MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="Busy" OnClick="() => Accept(o)">@(back is null ? T("Accept") : T("Accept both"))</MudButton></td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
        @if (PageCount > 1)
        {
            <MudPagination Count="PageCount" Selected="_page + 1" SelectedChanged="(int p) => _page = p - 1" Class="mt-2" />
        }
    }
</MudPaper>

@code {
    private const int PageSize = 50;
    private string _airlineIcao = "";

    /// <summary>ATC callsign of a job (airline ICAO + flight number), as sent to SimBrief.</summary>
    private string Callsign(MissionContract c) => AirlineCodes.Callsign(_airlineIcao, CareerService.FlightNumberOf(c));
    private int _page;
    private int PageCount => (VisibleOffers.Count() + PageSize - 1) / PageSize;
    private List<MissionContract> _offers = [], _active = [];
    private List<FleetAircraft> _fleet = [];
    private SettlementResult? _settlement;
    private readonly Dictionary<Guid, IReadOnlyList<LoadDeviation>> _loadCheck = [];
    private FlightPhase? _lastPhase;
    private MissionMap? _map;
    private Dictionary<string, SkyCareer.Domain.World.Airport> _airports = [];
    private List<MissionMap.FleetPoint> _fleetPoints = [];
    private List<MissionMap.Route> _routes = [];
    private (double Lat, double Lon, string Label)? _live;
    private DateTime _lastLiveUpdate, _gameTime;
    private Guid? _selected;
    private bool _airportDataOutdated;
    private int _reputation;
    private double _passengerWeightKg = PassengerMassTable.SimBriefAdultKg;
    private bool _detailedLoad;
    private bool _persistFuel;
    private string? _searchStatus;

    protected override async Task OnInitializedAsync()
    {
        Monitor.Changed += OnMonitorChanged;
        Gsx.Changed += OnGsxChanged;
        Departure.Changed += OnDepartureChanged;
        await base.OnInitializedAsync();
    }

    private void OnGsxChanged() => InvokeAsync(StateHasChanged);

    // The coordinator ticks about once a second; that's also the refresh rate of the traffic light.
    private void OnDepartureChanged() => InvokeAsync(StateHasChanged);

    private void CloseSettlement()
    {
        _settlement = null;
        Departure.Automation.ClearSettlement();
    }

    private string StatusText(MissionContract c, bool tracking) => c.Status switch
    {
        ContractStatus.InProgress when tracking && Departure.Automation.Waiting is { } waiting => waiting,
        ContractStatus.InProgress => F("In flight – {0}", MissionTexts.Phase(tracking ? Monitor.Phase : null)),
        _ when tracking => F("Ready – {0}", MissionTexts.Phase(Monitor.Phase)),
        _ => F("Accepted – waiting for aircraft at {0}", c.Origin)
    };

    private void ChooseJob(MissionContract c)
    {
        if (!Departure.Automation.Choose(c.Id))
            Snackbar.Add(T("Switching is only possible on the ground before taxiing."), Severity.Warning);
    }

    /// <summary>
    /// GSX is pointed at a job by the automation (armed or resumed); this only refreshes its load sheet and settings and
    /// stops GSX once that job is no longer open. With several aircraft on jobs, picking one here would retarget GSX.
    /// </summary>
    private async Task TrackGsxAsync()
    {
        var job = _active.FirstOrDefault(c => c.Id == Gsx.ContractId);
        var aircraft = job is null ? null : _fleet.FirstOrDefault(f => f.Id == job.AircraftId);
        if (job is null || aircraft is null)
        {
            if (Gsx.ContractId is not null) Gsx.Stop();
            return;
        }
        var career = await Career.GetCareerAsync();
        Gsx.Track(job.Id, Career.BuildLoadSheet(job, Career.Profile(aircraft.ProfileId)), career.GsxSyncEnabled, career.GsxCostsEnabled,
            departed: job.Status == ContractStatus.InProgress);
    }

    private Task SetGsxSync(bool enabled) => Run(async () =>
    {
        await Career.UpdateGsxSyncAsync(enabled);
        Gsx.SetSyncEnabled(enabled);
    });

    private Task ExportPlan(MissionContract c, MissionType type) => Run(async () =>
    {
        if (!_airports.TryGetValue(c.Origin, out var from) || !_airports.TryGetValue(c.Destination, out var to))
            throw new CareerException(T("Airport data for the job is missing."));
        var rules = type.FlightRules == FlightRulesRequirement.Vfr ? PlanRules.Vfr : PlanRules.Ifr;
        var plan = PlnExporter.Build(from, to, rules, title: $"{type.DisplayName} {c.Origin}-{c.Destination}");
        var path = await PlnExporter.SaveAsync(plan, PlnExporter.DefaultDirectory, $"{c.Origin}-{c.Destination}");
        Process.Start(new ProcessStartInfo("explorer.exe", $"/select,\"{path}\"") { UseShellExecute = true });
        Snackbar.Add(rules == PlanRules.Ifr
            ? T("Flight plan saved (direct route). For IFR with BeyondATC, better use the SimBrief OFP.")
            : T("Flight plan saved – load it in BeyondATC under VFR › file import or in the EFB."), Severity.Success);
    });

    private static string GsxText(GsxServiceState s) => s switch
    {
        GsxServiceState.Callable => T("ready"),
        GsxServiceState.NotAvailable => T("n/a"),
        GsxServiceState.Bypassed => T("skipped"),
        GsxServiceState.Requested => T("requested"),
        GsxServiceState.Performing => T("in progress"),
        GsxServiceState.Completed => T("completed"),
        _ => "–"
    };

    // Telemetry arrives several times per second; re-render on phase changes and move the live marker every 2 s.
    private void OnMonitorChanged()
    {
        var phase = Monitor.Phase;
        bool phaseChanged = phase != _lastPhase;
        _lastPhase = phase;

        bool moveLive = DateTime.UtcNow - _lastLiveUpdate > TimeSpan.FromSeconds(2);
        if (moveLive)
        {
            _lastLiveUpdate = DateTime.UtcNow;
            _live = Monitor.Latest is { } t && Monitor.Connection == ConnectionState.Connected && (t.Latitude != 0 || t.Longitude != 0)
                ? (t.Latitude, t.Longitude, $"{t.AircraftTitle} · {t.AltitudeFt:N0} ft · {t.GroundSpeedKt:N0} kt")
                : null;
        }
        if (phaseChanged || moveLive) InvokeAsync(StateHasChanged);
    }

    protected override async Task LoadAsync()
    {
        var career = await Career.GetCareerAsync();
        _airlineIcao = CareerService.AirlineIcaoOf(career);
        _gameTime = career.GameTime;
        _reputation = career.Reputation;
        _passengerWeightKg = career.PassengerWeightKg;
        _detailedLoad = career.SimBriefDetailedLoad;
        _persistFuel = career.PersistFuel;
        _fleet = await Career.GetFleetAsync();
        if (Filter.LoadedFor != career.Id)
        {
            Filter.Load(career.MarketFilterJson);
            Filter.LoadedFor = career.Id;
        }
        _offers = await Career.GetContractsAsync(ContractStatus.Offered);
        // A package's return leg waits below its outbound.
        _active = (await Career.GetContractsAsync(ContractStatus.Accepted, ContractStatus.InProgress))
            .OrderBy(c => c.Status != ContractStatus.InProgress).ThenBy(c => c.IsReturnLeg).ToList();
        if (Filter.AircraftId is { } f && _fleet.All(a => a.Id != f)) Filter.AircraftId = null;
        _airportDataOutdated = await Career.AirportDataOutdatedAsync();

        var idents = _fleet.Select(a => a.Location)
            .Concat(_offers.SelectMany(o => new[] { o.Origin, o.Destination }))
            .Concat(_active.SelectMany(o => new[] { o.Origin, o.Destination }));
        _airports = await Career.GetAirportsAsync(idents);
        _page = Math.Clamp(_page, 0, Math.Max(0, PageCount - 1));
        BuildMapData();
        await TrackGsxAsync();
    }

    /// <summary>Offers passing the job-search filter (aircraft plus <see cref="MissionSearch"/> criteria).</summary>
    private IEnumerable<MissionContract> VisibleOffers
    {
        get
        {
            var search = Filter.ToSearch();
            return _offers.Where(o => !o.IsReturnLeg && (Filter.AircraftId is not { } id || o.AircraftId == id) &&
                                      _fleet.Any(f => f.Id == o.AircraftId && f.Location == o.Origin) &&
                                      search.Matches(o, _airports.GetValueOrDefault(o.Destination)));
        }
    }

    private IEnumerable<MissionContract> SortedOffers
    {
        get
        {
            Func<MissionContract, IComparable> key = Filter.SortColumn switch
            {
                OfferColumn.Aircraft => o => _fleet.FirstOrDefault(f => f.Id == o.AircraftId)?.Registration ?? "",
                OfferColumn.Mission => o => Career.MissionType(o.MissionTypeId).DisplayName,
                OfferColumn.Distance => o => o.DistanceNm,
                OfferColumn.Runway => o => _airports.GetValueOrDefault(o.Destination)?.LongestRunwayM ?? 0,
                OfferColumn.Load => o => o.TotalPassengers * 100_000.0 + o.CargoKg,
                OfferColumn.BlockFuel => o => o.PlannedBlockFuelKg,
                OfferColumn.Deadline => o => o.Deadline,
                OfferColumn.Expires => o => o.ExpiresAt,
                _ => o => OfferValue(o)
            };
            return Filter.SortDescending ? VisibleOffers.OrderByDescending(key) : VisibleOffers.OrderBy(key);
        }
    }

    private Task SortBy(OfferColumn column)
    {
        if (Filter.SortColumn == column) Filter.SortDescending = !Filter.SortDescending;
        else
        {
            Filter.SortColumn = column;
            // Money and size read best biggest-first; everything else starts ascending.
            Filter.SortDescending = column is OfferColumn.Payout or OfferColumn.Runway or OfferColumn.Load;
        }
        _page = 0;
        return SaveFilterAsync();
    }

    /// <summary>The filter is kept with the career, so it is still set after a restart.</summary>
    private Task SaveFilterAsync() => Career.SaveMarketFilterAsync(Filter.ToJson());

    private RenderFragment SortHeader(OfferColumn column, string title) =>
        @<th class="sc-sortable @(Filter.SortColumn == column ? "sc-sorted" : "")" @onclick="() => SortBy(column)">
            @title @(Filter.SortColumn == column ? (Filter.SortDescending ? "▼" : "▲") : "")
        </th>;

    /// <summary>Destination summary: longest runway, surface, lighting and ILS (✓ yes, – no, ? not yet checked in the sim).</summary>
    private string CityOf(string ident) => _airports.TryGetValue(ident, out var a) ? MissionTexts.CityShort(a) : "";

    private RenderFragment DestinationInfo(string ident) => builder =>
    {
        if (!_airports.TryGetValue(ident, out var a))
        {
            builder.AddContent(0, "–");
            return;
        }
        string surface = a.HasPavedRunway ? T("paved") : a.Surfaces.Contains(RunwaySurface.Water) ? T("water") : T("unpaved");
        string ils = a.HasIls switch { true => "ILS ✓", false => T("no ILS"), null => "ILS ?" };
        builder.AddContent(1, $"{a.LongestRunwayM:N0} m {surface}");
        builder.AddMarkupContent(2, "<br />");
        builder.OpenElement(3, "span");
        builder.AddAttribute(4, "class", "mud-typography-caption");
        builder.AddContent(5, $"{(a.HasLightedRunway ? T("lighted · ") : "")}{ils}{(a.ScheduledService ? T(" · scheduled") : "")}{(a.IsMilitary ? T(" · military") : "")}");
        builder.CloseElement();
    };

    /// <summary>Creates new list instances so the map component knows it has to redraw.</summary>
    private void BuildMapData()
    {
        _fleetPoints = _fleet
            .Where(f => _airports.ContainsKey(f.Location))
            .GroupBy(f => f.Location)
            .Select(g => new MissionMap.FleetPoint(_airports[g.Key].Position.Latitude, _airports[g.Key].Position.Longitude,
                $"{g.Key}: {string.Join(", ", g.Select(f => f.Registration))}", g.Any(f => f.IsAvailable(_gameTime))))
            .ToList();

        _routes = VisibleOffers.Select(o => ToRoute(o, accepted: false))
            .Concat(_active.Select(o => ToRoute(o, accepted: true)))
            .OfType<MissionMap.Route>()
            .ToList();
    }

    private MissionMap.Route? ToRoute(MissionContract c, bool accepted)
    {
        if (!_airports.TryGetValue(c.Origin, out var from) || !_airports.TryGetValue(c.Destination, out var to)) return null;
        var type = Career.MissionType(c.MissionTypeId);
        string label = $"{type.DisplayName}: {c.Origin} → {c.Destination} · {c.DistanceNm:N0} nm · {Eur(c.Payout)}{(c.PackageId is not null ? T(" (round trip)") : "")}{(accepted ? T(" (accepted)") : "")}";
        string registration = _fleet.FirstOrDefault(f => f.Id == c.AircraftId) is { } plane
            ? $"{plane.Registration} ({Career.ProfileName(plane.ProfileId)})" : "";
        var details = new List<string>
        {
            $"{registration} · {c.Origin} → {c.Destination} · {c.DistanceNm:N0} nm",
            $"{PaxText(c)}{(c.CargoKg > 0 ? F(" · Cargo {0:N0} kg {1}", c.CargoKg, c.CargoKind) : "")} · {F("Block fuel {0:N0} kg", c.PlannedBlockFuelKg)}",
            $"{F("Deadline {0:dd.MM. HH:mm}", c.Deadline)}{(accepted ? "" : F(" · valid until {0:dd.MM. HH:mm}", c.ExpiresAt))}"
        };
        return new MissionMap.Route(c.Id, [from.Position.Latitude, from.Position.Longitude], [to.Position.Latitude, to.Position.Longitude],
            label, ColorFor(type), accepted, c.Id == _selected, to.Ident,
            MissionTexts.City(to) is { Length: > 0 } city ? $"{to.Name} ({city})" : to.Name, type.DisplayName, details, Eur(c.Payout));
    }

    /// <summary>Return legs opened by the user; a waiting return leg is shown collapsed.</summary>
    private readonly HashSet<Guid> _expanded = [];

    private void ToggleExpanded(Guid id)
    {
        if (!_expanded.Remove(id)) _expanded.Add(id);
    }

    /// <summary>A return leg whose aircraft hasn't reached its origin yet (the outbound is still ahead).</summary>
    private static bool IsWaitingReturn(MissionContract c, FleetAircraft? aircraft) =>
        c is { IsReturnLeg: true, Status: ContractStatus.Accepted } && aircraft is not null &&
        !string.Equals(aircraft.Location, c.Origin, StringComparison.OrdinalIgnoreCase);

    /// <summary>The return leg of a package outbound (on the market or accepted).</summary>
    private MissionContract? ReturnOf(MissionContract c) =>
        c is { PackageId: { } package, IsReturnLeg: false } ? _offers.Concat(_active).FirstOrDefault(x => x.PackageId == package && x.IsReturnLeg) : null;

    private decimal PackageBonus(MissionContract outbound, MissionContract back) =>
        Math.Round((Career.MissionType(back.MissionTypeId).ReturnFlight?.Bonus ?? 0.1m) * (outbound.Payout + back.Payout), 0);

    /// <summary>What accepting the offer is worth: with a return leg both payouts plus the package bonus.</summary>
    private decimal OfferValue(MissionContract o) => ReturnOf(o) is { } back ? o.Payout + back.Payout + PackageBonus(o, back) : o.Payout;

    private sealed record PrepStep(string Label, bool Done, bool Disabled, Func<Task> Action, string? Hint = null);

    /// <summary>The preparation of an accepted job in the order it is done; steps that don't apply to the type or aircraft are left out.</summary>
    private List<PrepStep> PreparationSteps(MissionContract c, MissionType type, AircraftProfile? profile, LoadSheet? sheet)
    {
        var steps = new List<PrepStep>();
        bool ofp = c.OfpBlockFuelKg is not null;
        bool loadOk = _loadCheck.TryGetValue(c.Id, out var check) && check.Count == 0;
        if (type.SimBrief != SimBriefUsage.None && profile is not null)
        {
            steps.Add(new(T("Plan in SimBrief"), ofp, false, () => { OpenSimBrief(c, profile); return Task.CompletedTask; },
                T("Opens SimBrief with the job's route, aircraft and load")));
            steps.Add(new(T("Load OFP"), ofp, false, () => ImportOfp(c, profile), T("Imports the OFP last generated in SimBrief (fuel, route)")));
        }
        if (sheet is not null && sheet.Aircraft.Loading == LoadingMethod.SimConnectStations)
            steps.Add(new(T("Load in sim"), loadOk, Monitor.Loader is null, () => LoadIntoSim(c, sheet),
                Monitor.Loader is null ? T("Only when connected to MSFS") : T("Sets payload and fuel according to the load sheet")));
        if (sheet is not null)
            steps.Add(new(T("Verify load"), loadOk, Monitor.Inspector is null, () => VerifyLoad(c, sheet),
                Monitor.Inspector is null ? T("Only when connected to MSFS") : T("Compares payload and fuel in the sim with the load sheet")));
        return steps;
    }

    /// <summary>"Show in list" from a map popup: highlight the row and scroll to it.</summary>
    private async Task ShowOffer(Guid id)
    {
        _selected = id;
        // The row may sit on another page of the list.
        int index = SortedOffers.Select(o => o.Id).ToList().IndexOf(id);
        if (index >= 0) _page = index / PageSize;
        BuildMapData();
        StateHasChanged();
        if (_map is not null) await _map.ScrollToAsync($"offer-{id:N}");
    }

    /// <summary>"Accept" from a map popup.</summary>
    private Task AcceptFromMap(Guid id) =>
        _offers.FirstOrDefault(o => o.Id == id) is { } offer ? Accept(offer) : Task.CompletedTask;

    private void SelectOffer(Guid id)
    {
        _selected = _selected == id ? null : id;
        BuildMapData();
    }

    private Task FilterChanged()
    {
        _selected = null;
        _page = 0;
        BuildMapData();
        return SaveFilterAsync();
    }

    private static readonly (string Category, string Color)[] CategoryColors =
    [
        ("airline", "#4f8ef7"), ("charter", "#c48af0"), ("cargo", "#f2a33a"), ("medical", "#e5534b"), ("bush", "#57ab5a")
    ];

    private static string ColorFor(MissionType t) =>
        CategoryColors.FirstOrDefault(c => c.Category == t.Category).Color ?? "#9aa0a6";


    private Task Search() => Run(async () =>
    {
        var search = Filter.ToSearch();
        _searchStatus = search.RequireIls && IlsLookup.Available
            ? T("Searching – unknown destination airports are checked for ILS in the simulator …")
            : T("Searching …");
        StateHasChanged();
        try
        {
            var r = await Career.SearchMarketAsync(search, Filter.AircraftId);
            Snackbar.Add(r.Created == 0
                    ? T("No matching jobs found – relax the filters (e.g. distance or runway length).")
                    : F("{0} new jobs", r.Created) + (r.IlsChecked > 0 ? F(" ({0} airports checked for ILS)", r.IlsChecked) : "") + ".",
                r.Created == 0 ? Severity.Warning : Severity.Success);
            if (r.IlsUnavailable)
                Snackbar.Add(T("MSFS is not connected: only airports with known ILS data were used."), Severity.Info);
            if (_map is not null) await _map.FitAsync();
        }
        finally
        {
            _searchStatus = null;
        }
    });

    private Task Accept(MissionContract o) => Run(() => Career.AcceptAsync(o.Id), ReturnOf(o) is null ? T("Job accepted.") : T("Outbound and return flight accepted."));

    private async Task Cancel(MissionContract c)
    {
        var back = ReturnOf(c) is { Status: ContractStatus.Accepted } r ? r : null;
        decimal penalty = Math.Round(c.Payout * CareerService.CancellationPenalty, 0) + (back is null ? 0 : Math.Round(back.Payout * CareerService.CancellationPenalty, 0));
        string question = back is not null ? F("Cancel outbound and return flight? Cancellation penalty {0}.", Eur(penalty))
            : c.IsReturnLeg ? F("Cancel the return flight? Cancellation penalty {0}, the package bonus is lost.", Eur(penalty))
            : F("Cancel the job? Cancellation penalty {0}.", Eur(penalty));
        if (await Dialogs.ShowMessageBoxAsync(T("Cancel job"), question, yesText: T("Cancel job"), cancelText: T("Back")) != true)
            return;
        await Run(async () =>
        {
            await Career.CancelAsync(c.Id);
            if (Monitor.ContractId == c.Id) Monitor.EndFlight();
        }, T("Job cancelled."));
    }

    // Normally automatic after a restart; continues from the flight journal when there is one.
    private void ResumeTracking(MissionContract c)
    {
        var startedAt = c.FlightStartedAtUtc is { } utc ? new DateTimeOffset(DateTime.SpecifyKind(utc, DateTimeKind.Utc)) : DateTimeOffset.UtcNow;
        if (!Monitor.ResumeFlight(c.Id, startedAt, c.FuelAtBlockOffKg))
            Snackbar.Add(T("No flight data: connect to MSFS first."), Severity.Warning);
    }

    private void OpenSimBrief(MissionContract c, AircraftProfile p)
    {
        var load = SimBriefPayload.For(Career.BuildLoadSheet(c, p), _passengerWeightKg, _detailedLoad);
        int flightNumber = CareerService.FlightNumberOf(c);
        var uri = SimBriefClient.BuildDispatchUri(new DispatchRequest(c.Origin, c.Destination, p.IcaoType, load.Passengers, load.CargoKg, ZeroFuelWeightKg: load.ZeroFuelWeightKg,
            Airframe: p.SimBriefAirframe, Airline: _airlineIcao, FlightNumber: flightNumber.ToString(System.Globalization.CultureInfo.InvariantCulture),
            Callsign: AirlineCodes.Callsign(_airlineIcao, flightNumber)));
        Process.Start(new ProcessStartInfo(uri.ToString()) { UseShellExecute = true });
    }

    private Task ImportOfp(MissionContract c, AircraftProfile p) => Run(async () =>
    {
        var career = await Career.GetCareerAsync();
        if (career.SimBriefUser is null) throw new CareerException(T("Please enter your SimBrief username under “Settings” first."));
        var ofp = await SimBrief.FetchLatestAsync(career.SimBriefUser);
        var sheet = Career.BuildLoadSheet(c, p);
        bool detailed = career.SimBriefDetailedLoad;
        var load = SimBriefPayload.For(sheet, career.PassengerWeightKg, detailed);
        // The link sent our ZFW (manualzfw): SimBrief plans it exactly and balances the freight.
        var problems = OfpValidator.Validate(ofp, new OfpExpectation(c.Origin, c.Destination, p.IcaoType, load.Passengers, load.CargoKg,
            load.ExpectedPayloadKg, sheet.ZeroFuelWeight.Kg, p.MaxZeroFuelKg, career.PassengerWeightKg,
            career.BagWeightKg, BagsAsFreight: detailed, ManualZfw: true));
        if (!ofp.Origin.Equals(c.Origin, StringComparison.OrdinalIgnoreCase) || !ofp.Destination.Equals(c.Destination, StringComparison.OrdinalIgnoreCase))
            throw new CareerException(F("The latest OFP doesn't match the job: {0}", string.Join("; ", problems)));
        foreach (var problem in problems) Snackbar.Add(problem, Severity.Warning);
        await Career.SetOfpAsync(c.Id, ofp.BlockFuelKg, ofp.TripFuelKg, ofp.Route);
        Snackbar.Add(F("OFP imported: block fuel {0:N0} kg.", ofp.BlockFuelKg), Severity.Success);
    });

    private Task LoadIntoSim(MissionContract c, LoadSheet sheet) => Run(async () =>
    {
        await Monitor.Loader!.ApplyPayloadAsync(sheet.Stations);
        await Monitor.Loader.ApplyFuelAsync(sheet.Fuel.Block);
        await Task.Delay(1500); // let the sim recompute weights before reading back
        await CheckLoad(c, sheet);
    });

    private Task VerifyLoad(MissionContract c, LoadSheet sheet) => Run(() => CheckLoad(c, sheet));

    private async Task CheckLoad(MissionContract c, LoadSheet sheet)
    {
        var snap = await Monitor.Inspector!.ReadAircraftAsync();
        _loadCheck[c.Id] = LoadVerifier.Verify(sheet, Mass.FromKg(snap.PayloadKg), Mass.FromKg(snap.FuelKg));
    }

    private async Task Complete(MissionContract c)
    {
        if (Monitor.Phase != FlightPhase.Arrived &&
            await Dialogs.ShowMessageBoxAsync(T("Settle flight"), F("The flight is not finished yet ({0}). Settle now? If the aircraft is not at the destination, there is no payout.", MissionTexts.Phase(Monitor.Phase)),
                yesText: T("Settle"), cancelText: T("Keep flying")) != true)
            return;

        await Run(async () =>
        {
            var summary = Monitor.Summarize() ?? throw new CareerException(T("No flight data available."));
            var track = await Monitor.SaveTrackAsync($"{c.Origin}-{c.Destination}-{c.Id:N}");
            _settlement = await Career.CompleteFlightAsync(c.Id, FlightResultMapper.Map(summary, Monitor.DepartureIssues), track);
            Monitor.EndFlight();
        });
    }

    private string PaxText(MissionContract c) => c.TotalPassengers == 0 ? "–"
        : $"{F("{0} pax", c.TotalPassengers)}{OccupancyText(c)}{(c.Children + c.Infants > 0 ? F(" ({0} children, {1} infants)", c.Children, c.Infants) : "")}";

    /// <summary>" · 79 % occupied" when the mission fills seats of a known aircraft.</summary>
    private string OccupancyText(MissionContract c)
    {
        if (_fleet.FirstOrDefault(f => f.Id == c.AircraftId) is not { } plane) return "";
        int capacity = SkyCareer.Missions.Generation.StandardMissionGenerator.Capacity(Career.MissionType(c.MissionTypeId), Career.Profile(plane.ProfileId));
        return capacity > 0 ? F(" · {0:P0} occupied", (c.Adults + c.Children) / (double)capacity) : "";
    }

    private static string OutcomeText(FlightOutcome o) => o switch
    {
        FlightOutcome.Completed => T("Successful"),
        FlightOutcome.Late => T("Late"),
        FlightOutcome.Diverted => T("Not at destination"),
        FlightOutcome.Crashed => T("Crashed"),
        FlightOutcome.Failed => T("Cancelled"),
        _ => o.ToString()
    };

    public override void Dispose()
    {
        Monitor.Changed -= OnMonitorChanged;
        Departure.Changed -= OnDepartureChanged;
        Gsx.Changed -= OnGsxChanged;
        base.Dispose();
    }
