@page "/fleet/{Id:guid}"
@inherits CareerPageBase
@inject IDialogService Dialogs
@inject NavigationManager Nav

@if (_details is { } d && _profile is { } p)
{
    var f = d.Aircraft;
    var parts = f.Components;
    bool flying = d.OpenJobs.Any(j => j.Status == ContractStatus.InProgress);
    bool rented = f.Ownership == Ownership.Rented;

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="fleet" />
        <MudText Typo="Typo.h5">@f.Registration</MudText>
        <MudLink Href="@($"aircraft/edit?id={Uri.EscapeDataString(p.Id)}")" Typo="Typo.h6">@p.Name</MudLink>
        @if (flying)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning">@T("In flight")</MudChip>
        }
        else if (!f.IsAvailable(_gameTime))
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Error">@F("{0} until {1:dd.MM. HH:mm}", f.UnavailableReason ?? T("Maintenance"), f.UnavailableUntil)</MudChip>
        }
        else
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Success">@T("Available")</MudChip>
        }
    </MudStack>

    <MudGrid Class="mb-4">
        @foreach (var (label, value, bad) in Overview(f, p))
        {
            <MudItem xs="6" sm="4" md="3" lg="2">
                <MudPaper Class="pa-3" Style="height:100%">
                    <MudText Typo="Typo.caption">@label</MudText>
                    <MudText Typo="Typo.subtitle1" Class="@(bad ? "bad" : "")">@value</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.h6">@T("Components")</MudText>
            <MudSpacer />
            @if (!rented && FleetEconomics.RepairCost(p, f) > 0)
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(Busy || flying)" OnClick="RepairAll">
                    @F("Full repair ({0} · 1 day)", Eur(FleetEconomics.RepairCost(p, f)))
                </MudButton>
            }
        </MudStack>
        @if (parts.IsEmpty)
        {
            <MudText Typo="Typo.body2">@T("No MSFS wear data yet – it is recorded on the first flight with the simulator connected.")</MudText>
        }
        else
        {
            @if (rented)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">@T("Rental aircraft are maintained by the lessor; no repairs needed.")</MudAlert>
            }
            <MudExpansionPanels MultiExpansion="true" Elevation="0" Outlined="true">
                @foreach (var group in GroupsOf(parts))
                {
                    var ids = group.Components.Where(c => c.Level < 1).Select(c => c.Component.Id).ToList();
                    var groupCost = FleetEconomics.ComponentRepairCost(p, parts, ids);
                    <MudExpansionPanel>
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Style="width:100%">
                                <MudText Style="min-width:140px"><b>@group.Name</b></MudText>
                                <MudProgressLinear Value="@(group.Worst * 100)" Color="@LevelColor(group.Worst)" Style="max-width:220px" />
                                <MudText Class="@(group.Worst < WearComponents.WarningLevel ? "bad" : "")" Style="min-width:50px">@group.Worst.ToString("P0")</MudText>
                                <MudSpacer />
                                @if (!rented && ids.Count > 0 && groupCost > 0)
                                {
                                    @* Own span so the click doesn't also toggle the panel. *@
                                    <span @onclick:stopPropagation="true">
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(Busy || flying)" OnClick="() => RepairParts(ids, group.Name)">
                                            @F("Repair group ({0} · {1})", Eur(groupCost), FleetTexts.Downtime(WearComponents.RepairDowntime(group.Components[0].Component.GroupKey)))
                                        </MudButton>
                                    </span>
                                }
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudSimpleTable Dense="true">
                                <tbody>
                                    @foreach (var (component, level) in group.Components)
                                    {
                                        var cost = FleetEconomics.ComponentRepairCost(p, parts, [component.Id]);
                                        <tr>
                                            <td>@component.Name</td>
                                            <td style="width:220px"><MudProgressLinear Value="@(level * 100)" Color="@LevelColor(level)" /></td>
                                            <td class="@(level < WearComponents.WarningLevel ? "bad" : "")" style="width:60px">@level.ToString("P0")</td>
                                            <td style="text-align:right;width:260px">
                                                @if (!rented && level < 0.995 && cost > 0)
                                                {
                                                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@(Busy || flying)" OnClick="() => RepairParts([component.Id], component.Name)">
                                                        @F("Repair ({0})", Eur(cost))
                                                    </MudButton>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
            <MudText Typo="Typo.caption" Class="mt-2 d-block">
                @T("After each flight SkyCareer takes over the wear MSFS reported during it. Below 70 % the departure check warns, and worn components raise the maintenance reserve. Shop time: tires and brakes 2 h, engine 1 day, otherwise 6 h. MSFS keeps its own wear, which SkyCareer cannot set: repairs here only apply in SkyCareer; repair in the simulator via its maintenance menu.")
            </MudText>
        }
    </MudPaper>

    <MudGrid Class="mb-4">
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4" Style="height:100%">
                <MudText Typo="Typo.h6" Class="mb-2">@T("Economics")</MudText>
                @{
                    var operating = d.Ledger.Where(l => FleetTexts.IsOperating(l.Category)
                        && l.Category is not (LedgerCategory.AircraftPurchase or LedgerCategory.AircraftSale)).ToList();
                    decimal revenue = operating.Where(l => l.Amount > 0).Sum(l => l.Amount);
                    decimal costs = -operating.Where(l => l.Amount < 0).Sum(l => l.Amount);
                }
                @if (operating.Count == 0)
                {
                    <MudText Typo="Typo.body2">@T("No ledger entries for this aircraft yet.")</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true">
                        <tbody>
                            @foreach (var g in operating.GroupBy(l => l.Category).OrderByDescending(g => g.Sum(l => l.Amount)))
                            {
                                <tr><td>@FleetTexts.Category(g.Key)</td><td style="text-align:right" class="@(g.Sum(l => l.Amount) < 0 ? "bad" : "ok")">@Eur(g.Sum(l => l.Amount))</td></tr>
                            }
                            <tr><td>@T("Revenue / costs")</td><td style="text-align:right">@Eur(revenue) / @Eur(costs)</td></tr>
                            <tr><td><b>@T("Result")</b></td><td style="text-align:right" class="@(revenue - costs < 0 ? "bad" : "ok")"><b>@Eur(revenue - costs)</b></td></tr>
                            @if (d.Flights.Sum(x => x.BlockHours) is var hours and > 0)
                            {
                                <tr><td>@T("Result per block hour")</td><td style="text-align:right">@Eur((revenue - costs) / (decimal)hours)</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    @if (d.Ledger.Any(l => l.Category is LedgerCategory.AircraftPurchase or LedgerCategory.AircraftSale))
                    {
                        <MudText Typo="Typo.caption">@T("Excluding purchase/sale of the aircraft.")</MudText>
                    }
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-4" Style="height:100%">
                <MudText Typo="Typo.h6" Class="mb-2">@T("Jobs & actions")</MudText>
                @if (d.OpenJobs.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mb-3">@T("No accepted job.")</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Class="mb-3">
                        <tbody>
                            @foreach (var j in d.OpenJobs)
                            {
                                <tr>
                                    <td>@j.Origin → @j.Destination</td>
                                    <td>@F("Deadline {0:dd.MM. HH:mm}", j.Deadline)</td>
                                    <td>@Eur(j.Payout)</td>
                                    <td>
                                        <MudLink Href="@(j.Status == ContractStatus.InProgress ? "live" : "")">
                                            @(j.Status == ContractStatus.InProgress ? T("In flight – Live flight") : T("Accepted – Jobs"))
                                        </MudLink>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="Busy" Href="@($"fleet?relocate={f.Id}")">@T("Change location")</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="Busy" OnClick="DisposeAircraft">@FleetTexts.DisposeAction(f.Ownership)</MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">@F("Flights ({0})", d.Flights.Count)</MudText>
        @if (d.Flights.Count == 0)
        {
            <MudText Typo="Typo.body2">@T("No flights with this aircraft yet.")</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true">
                <thead><tr><th>@T("Arrival")</th><th>@T("Route")</th><th>@T("Block")</th><th>@T("Landing")</th><th>@T("Score")</th><th>@T("Status")</th><th style="text-align:right">@T("Result")</th></tr></thead>
                <tbody>
                    @foreach (var fl in d.Flights)
                    {
                        <tr style="cursor:pointer" title="@T("Open in logbook")" @onclick="@(() => Nav.NavigateTo($"logbook?flight={fl.Id}"))">
                            <td>@fl.ArrivedGameTime.ToString("dd.MM.yy HH:mm")</td>
                            <td>@fl.Origin → @fl.Destination@(fl.ArrivedAt != fl.Destination ? F(" (landed at {0})", fl.ArrivedAt) : "")</td>
                            <td>@fl.BlockHours.ToString("N1") h</td>
                            <td>@fl.TouchdownFpm.ToString("N0") fpm</td>
                            <td>@fl.Score</td>
                            <td>@fl.Outcome</td>
                            <td style="text-align:right" class="@(fl.Revenue - fl.Costs < 0 ? "bad" : "ok")">@Eur(fl.Revenue - fl.Costs)</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>
}
else if (_missing)
{
    <MudAlert Severity="Severity.Warning">@T("This aircraft is no longer part of the fleet.") <MudLink Href="fleet">@T("Go to fleet")</MudLink></MudAlert>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private AircraftDetails? _details;
    private AircraftProfile? _profile;
    private DateTime _gameTime;
    private EconomyTables? _economy;
    private bool _missing;

    private sealed record PartGroup(string Name, double Worst, IReadOnlyList<(WearComponent Component, double Level)> Components);

    protected override async Task LoadAsync()
    {
        var career = await Career.GetCareerAsync();
        _gameTime = career.GameTime;
        _economy = EconomyTables.For(career.Difficulty);
        try
        {
            _details = await Career.GetAircraftDetailsAsync(Id);
            _profile = Career.Profile(_details.Aircraft.ProfileId);
            _missing = false;
        }
        catch (CareerException)
        {
            // Sold or returned (also from this page): show the hint instead of a snackbar.
            _details = null;
            _missing = true;
        }
    }

    private IEnumerable<(string Label, string Value, bool Bad)> Overview(FleetAircraft f, AircraftProfile p)
    {
        yield return (T("Status"), FleetTexts.Ownership(f.Ownership), false);
        yield return (T("Location"), f.Location, false);
        yield return (T("Hours / cycles"), $"{f.AirframeHours:N1} h / {f.Cycles}", false);
        yield return (T("Fuel on board"), FleetTexts.Fuel(f, p), false);
        yield return (T("Condition"), $"{f.Condition:N0} %", f.Condition < 70);
        yield return (T("Worst component"), f.Components.Worst is { } w ? $"{w.Component.Name} {w.Level:P0}" : "–", f.Components.WorstLevel < WearComponents.WarningLevel);
        yield return (T("Next check"), f.Ownership == Ownership.Rented ? T("incl.") : F("in {0:N0} h", Math.Max(0, FleetEconomics.CheckIntervalHours(p) - f.HoursSinceCheck)), false);
        yield return (f.Ownership == Ownership.Owned ? T("Market value") : T("Rate"), FleetTexts.Value(f, p, _gameTime), false);
        if (f.Ownership == Ownership.Owned) yield return (T("Sale proceeds"), Eur(FleetEconomics.SaleValue(p, f, _gameTime)), false);
        if (f.Ownership != Ownership.Rented) yield return (T("Fixed costs/month"), Eur(FleetEconomics.MonthlyFixedCost(p, f)), false);
        yield return (T("Maintenance reserve/FH"), Eur(CostModel.Maintenance(_economy!, p, 1, f.EffectiveCondition)), f.EffectiveCondition < 70);
    }

    private static IEnumerable<PartGroup> GroupsOf(AircraftWear parts) =>
        parts.Levels.Select(kv => (Component: WearComponents.All[kv.Key], Level: kv.Value))
            .GroupBy(c => c.Component.Group)
            .Select(g => new PartGroup(g.Key, g.Min(c => c.Level), g.OrderBy(c => c.Level).ThenBy(c => c.Component.Id).ToList()))
            .OrderBy(g => g.Worst);

    private static Color LevelColor(double level) =>
        level < WearComponents.WarningLevel ? Color.Error : level < 0.9 ? Color.Warning : Color.Success;

    private Task RepairParts(IReadOnlyCollection<int> ids, string what) =>
        Run(() => Career.RepairComponentsAsync(Id, ids), F("{0} is being repaired.", what));

    private Task RepairAll() => Run(() => Career.RepairAsync(Id), F("{0} is being repaired (1 day).", _details!.Aircraft.Registration));

    private async Task DisposeAircraft()
    {
        var f = _details!.Aircraft;
        if (await Dialogs.ShowMessageBoxAsync(T("Confirm"), FleetTexts.DisposeQuestion(f, _profile!, _gameTime), yesText: T("Yes"), cancelText: T("Cancel")) == true)
        {
            await Run(() => Career.DisposeAircraftAsync(f.Id), T("Done."));
            Nav.NavigateTo("fleet");
        }
    }
}
