@page "/logbook"
@inherits CareerPageBase
@using Microsoft.JSInterop
@inject IJSRuntime JS

<MudText Typo="Typo.h5" Class="mb-4">@T("Logbook")</MudText>

@if (_flights.Count == 0)
{
    <MudText Typo="Typo.body2">@T("No flights yet.")</MudText>
}
else
{
    <MudText Typo="Typo.body2" Class="mb-2">
        @F("{0} flights · {1:N1} block hours · avg. score {2:N0}", _flights.Count, _flights.Sum(f => f.BlockHours), _flights.Average(f => f.Score))
        · @T("Result") @Eur(_flights.Sum(f => f.Revenue - f.Costs))
    </MudText>
    <MudSimpleTable Dense="true" Hover="true">
        <thead><tr><th>@T("Arrival")</th><th>@T("Job")</th><th>@T("Route")</th><th>@T("Aircraft")</th><th>@T("Block")</th><th>@T("Landing")</th><th>@T("Score")</th><th>@T("Result")</th><th>@T("Status")</th><th>GSX</th></tr></thead>
        <tbody>
            @foreach (var f in _flights)
            {
                <tr title="@f.Notes" id="@($"flight-{f.Id}")" style="@(f.Id == Flight ? "background:var(--mud-palette-action-default-hover)" : null)">
                    <td>@f.ArrivedGameTime.ToString("dd.MM.yy HH:mm")</td>
                    <td>@(Career.Content.MissionTypes.FirstOrDefault(m => m.Id == f.MissionTypeId)?.DisplayName ?? f.MissionTypeId)</td>
                    <td>
                        @f.Origin → @f.Destination@(f.ArrivedAt != f.Destination ? F(" (landed at {0})", f.ArrivedAt) : "")
                        @if (f.FlightNumber is { } number)
                        {
                            <br /><MudText Typo="Typo.caption">@AirlineCodes.Callsign(_airlineIcao, number)</MudText>
                        }
                    </td>
                    <td>@(_registrations.GetValueOrDefault(f.AircraftId, "–"))</td>
                    <td>@f.BlockHours.ToString("N1") h</td>
                    <td>@f.TouchdownFpm.ToString("N0") fpm / @f.MaxGForce.ToString("N2") G</td>
                    <td>@f.Score</td>
                    <td class="@(f.Revenue - f.Costs < 0 ? "bad" : "ok")">@Eur(f.Revenue - f.Costs)</td>
                    <td>@f.Outcome</td>
                    <td>
                        @if (_receipts.TryGetValue(f.ContractId, out var list))
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Receipt"
                                       OnClick="() => Toggle(f.Id)">@list.Count</MudButton>
                        }
                    </td>
                </tr>
                @if (_open.Contains(f.Id) && _receipts.TryGetValue(f.ContractId, out var shown))
                {
                    <tr>
                        <td colspan="10" style="background:var(--mud-palette-background-gray)">
                            @foreach (var r in shown)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudText Typo="Typo.body2" Style="min-width:320px">@r.Title @r.Icao@(r.Operator.Length > 0 ? $" ({r.Operator})" : "")</MudText>
                                    <MudText Typo="Typo.body2" Style="min-width:100px;text-align:right">@Eur(-r.AmountEur)</MudText>
                                    <MudText Typo="Typo.caption" Style="flex:1">@r.Lines.Replace("\n", " · ")</MudText>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(r.StoredHtml is null)"
                                               OnClick="() => GsxReceiptWatcher.Open(r.StoredHtml)">@T("Open")</MudButton>
                                </MudStack>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    private List<FlightRecord> _flights = [];
    private Dictionary<Guid, string> _registrations = [];
    private Dictionary<Guid, List<GsxReceiptRecord>> _receipts = [];
    private readonly HashSet<Guid> _open = [];

    /// <summary>Highlights and scrolls to this flight (link from the aircraft detail page).</summary>
    [SupplyParameterFromQuery(Name = "flight")] public Guid? Flight { get; set; }
    private bool _scrolled;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrolled && Flight is { } id && _flights.Any(f => f.Id == id))
        {
            _scrolled = true;
            await JS.InvokeVoidAsync("skyMap.scrollToElement", $"flight-{id}");
        }
    }

    private string _airlineIcao = "";

    protected override async Task LoadAsync()
    {
        _airlineIcao = CareerService.AirlineIcaoOf(await Career.GetCareerAsync());
        _flights = await Career.GetFlightsAsync();
        _registrations = (await Career.GetFleetAsync()).ToDictionary(f => f.Id, f => f.Registration);
        _receipts = (await Career.GetGsxReceiptsAsync()).Where(r => r.ContractId is not null)
            .GroupBy(r => r.ContractId!.Value).ToDictionary(g => g.Key, g => g.OrderBy(r => r.CreatedUtc).ToList());
    }

    private void Toggle(Guid flightId)
    {
        if (!_open.Remove(flightId)) _open.Add(flightId);
    }
}
