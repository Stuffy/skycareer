@* Job search: the criteria filter the list and steer "Search jobs". *@
@inject CareerService Career

<MudPaper Class="pa-4 mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIconButton Icon="@(Filter.Expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small"
                       OnClick="() => Filter.Expanded = !Filter.Expanded" aria-label="@T("Expand/collapse filter")" />
        <MudText Typo="Typo.h6">@T("Job search")</MudText>
        @if (Filter.ActiveCount > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@F("{0} filters active", Filter.ActiveCount)</MudChip>
        }
        <MudSpacer />
        <MudButton Variant="Variant.Text" Disabled="@(Busy || Filter.ActiveCount == 0)" OnClick="Reset">@T("Reset filters")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" Disabled="@(Busy || !HasFleet)" OnClick="OnSearch">
            @T("Search jobs")
        </MudButton>
    </MudStack>

    @if (Filter.Expanded)
    {
        <MudGrid Class="mt-1" Spacing="2">
            <MudItem xs="12" md="4">
                <MudSelect T="Guid?" @bind-Value="Filter.AircraftId" @bind-Value:after="Changed" Label="@T("Aircraft")" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                           ToStringFunc="AircraftLabel">
                    @foreach (var f in Fleet)
                    {
                        <MudSelectItem T="Guid?" Value="@f.Id">@AircraftLabel(f.Id)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="string" MultiSelection="true" @bind-SelectedValues="Filter.MissionTypeIds" @bind-SelectedValues:after="Changed"
                           Label="@T("Mission types (empty = all)")" Variant="Variant.Outlined" Margin="Margin.Dense"
                           ToStringFunc="@(id => id is null ? "" : TypeName(id))">
                    @foreach (var t in MissionTypes)
                    {
                        <MudSelectItem T="string" Value="@t.Id">@MissionTexts.TypeOption(t, Reputation)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" md="2"><MudNumericField T="double?" @bind-Value="Filter.DistanceMinNm" @bind-Value:after="Changed" Label="@T("Distance min (nm)")" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" /></MudItem>
            <MudItem xs="6" md="2"><MudNumericField T="double?" @bind-Value="Filter.DistanceMaxNm" @bind-Value:after="Changed" Label="@T("Distance max (nm)")" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" /></MudItem>

            <MudItem xs="6" md="2"><MudNumericField T="int?" @bind-Value="Filter.PaxMin" @bind-Value:after="Changed" Label="@T("Passengers min")" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" /></MudItem>
            <MudItem xs="6" md="2"><MudNumericField T="int?" @bind-Value="Filter.PaxMax" @bind-Value:after="Changed" Label="@T("Passengers max")" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" /></MudItem>
            <MudItem xs="6" md="2"><MudNumericField T="double?" @bind-Value="Filter.CargoMinKg" @bind-Value:after="Changed" Label="@T("Cargo min (kg)")" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" /></MudItem>
            <MudItem xs="6" md="2"><MudNumericField T="decimal?" @bind-Value="Filter.PayoutMin" @bind-Value:after="Changed" Label="@T("Payout min (€)")" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" /></MudItem>
            <MudItem xs="6" md="2"><MudNumericField T="double?" @bind-Value="Filter.MinRunwayM" @bind-Value:after="Changed" Label="@T("Destination runway min (m)")" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" /></MudItem>
            <MudItem xs="6" md="2">
                <MudSelect T="AirportSize" MultiSelection="true" @bind-SelectedValues="Filter.Sizes" @bind-SelectedValues:after="Changed"
                           Label="@T("Destination size (empty = all)")" Variant="Variant.Outlined" Margin="Margin.Dense"
                           ToStringFunc="SizeText">
                    @foreach (var s in Enum.GetValues<AirportSize>())
                    {
                        <MudSelectItem T="AirportSize" Value="@s">@SizeText(s)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudStack Row="true" Spacing="4" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                    <MudCheckBox T="bool" @bind-Value="Filter.RequirePaved" @bind-Value:after="Changed" Label="@T("Paved runway")" Dense="true" />
                    <MudCheckBox T="bool" @bind-Value="Filter.RequireLighted" @bind-Value:after="Changed" Label="@T("Lighted runway")" Dense="true" />
                    <MudCheckBox T="bool" @bind-Value="Filter.ScheduledServiceOnly" @bind-Value:after="Changed" Label="@T("Scheduled service only")" Dense="true" />
                    <MudTooltip Text="@(IlsAvailable ? T("ILS data comes from the sim; unknown destinations are queried during the search.") : T("Only known ILS airports – start MSFS for new queries."))">
                        <MudCheckBox T="bool" @bind-Value="Filter.RequireIls" @bind-Value:after="Changed" Label="@(IlsAvailable ? T("ILS at destination") : T("ILS at destination (sim not connected)"))" Dense="true" />
                    </MudTooltip>
                </MudStack>
            </MudItem>
        </MudGrid>
        @if (AirportDataOutdated)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                @T("The airport data comes from an older version: details such as lighting, scheduled service, the served city (for major city and capital destinations) or the flagging of military airfields are missing.")
                @T("Re-import it under “Settings” → “Update airport data”.")
            </MudAlert>
        }
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public MarketFilter Filter { get; set; } = null!;
    [Parameter] public IReadOnlyList<FleetAircraft> Fleet { get; set; } = [];
    [Parameter] public IReadOnlyList<MissionType> MissionTypes { get; set; } = [];
    [Parameter] public bool IlsAvailable { get; set; }
    /// <summary>Current career reputation; types above it are marked as not yet available.</summary>
    [Parameter] public int Reputation { get; set; }
    [Parameter] public bool AirportDataOutdated { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnSearch { get; set; }
    /// <summary>Raised whenever a criterion changes so the page can re-filter the list and the map.</summary>
    [Parameter] public EventCallback OnFilterChanged { get; set; }

    private bool HasFleet => Fleet.Count > 0;

    private Task Changed() => OnFilterChanged.InvokeAsync();

    private Task Reset()
    {
        Filter.Reset();
        return Changed();
    }

    private string AircraftLabel(Guid? id) =>
        Fleet.FirstOrDefault(f => f.Id == id) is { } f ? $"{f.Registration} · {Career.ProfileName(f.ProfileId)} ({f.Location})" : "";

    private string TypeName(string id) =>
        MissionTypes.FirstOrDefault(t => t.Id == id) is { } t ? MissionTexts.TypeOption(t, Reputation) : id;

    public static string SizeText(AirportSize s) => s switch
    {
        AirportSize.Large => T("Large"),
        AirportSize.Medium => T("Medium"),
        AirportSize.Small => T("Small"),
        AirportSize.Heliport => T("Heliport"),
        AirportSize.Seaplane => T("Seaplane base"),
        _ => s.ToString()
    };
}
